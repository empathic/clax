load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

# The contract the Rust tests check the daemon against
# (crates/clax-server/src/routes/guards.rs).
filegroup(
    name = "contract",
    srcs = ["contract.md"],
    visibility = [
        "//apps/clax_app:__pkg__",
        "//crates:__subpackages__",
    ],
)

# The ClaxBot surfaces design's example surface files of a host's, which
# crates/clax-surface's tests read (src/tests/mod.rs), crates/clax-cli's
# check and convert (tests/bot_surface.rs) and crates/clax-bot's render a
# prompt for (src/prompt/live.rs).
filegroup(
    name = "claxbot_surface_examples",
    srcs = glob(["superpowers/specs/2026-11-10-claxbot-surfaces/*.d.ts"]),
    visibility = [
        "//crates/clax-bot:__pkg__",
        "//crates/clax-cli:__pkg__",
        "//crates/clax-surface:__pkg__",
    ],
)

# The contract fixture of the ClaxBot surfaces host protocol
# (contract.md, "ClaxBot surfaces"), which the tests of the protocol's
# messages (crates/clax-surface/src/tests/wire) and of its hub
# (crates/clax-bot/src/bot_surfaces/tests.rs) replay.
filegroup(
    name = "claxbot_surfaces_contract",
    srcs = ["claxbot-surfaces/contract.json"],
    visibility = ["//crates:__subpackages__"],
)

# The ClaxBot surfaces design, whose examples of the host protocol's
# messages crates/clax-surface's tests read (src/tests/wire).
filegroup(
    name = "claxbot_surfaces_design",
    srcs = ["superpowers/specs/2026-11-10-claxbot-surfaces-design.md"],
    visibility = ["//crates/clax-surface:__pkg__"],
)

# The Kubernetes guide, whose overlay of one's own clax-fleet's tests check
# against deploy/k8s (crates/clax-fleet/src/main.rs).
filegroup(
    name = "kubernetes",
    srcs = ["kubernetes.md"],
    visibility = ["//crates/clax-fleet:__pkg__"],
)

# The Terms of Service and Privacy Policy, which the web build renders
# into web/dist (web/scripts/build-legal.mjs) beside web/'s own files.
copy_to_bin(
    name = "legal",
    srcs = glob(["legal/*.md"]),
    visibility = ["//web:__pkg__"],
)

# The license text of web/bridge, web/overlay and web/sdk, which the SDK
# package carries (web/scripts/build-sdk.mjs).
copy_to_bin(
    name = "lgpl_license",
    srcs = ["licenses/LGPL-2.1-only.txt"],
    visibility = ["//web:__pkg__"],
)

# The GPL-2.0 text apps/clax_app's :licence_check compares the app's LICENSE
# with.
exports_files(
    ["licenses/GPL-2.0-only.txt"],
    visibility = ["//apps/clax_app:__pkg__"],
)

# The docs the release script test checks (scripts/test-release.files).
exports_files(
    [
        "contract.md",
        "kubernetes.md",
        "usage.md",
    ],
    visibility = ["//scripts:__pkg__"],
)
