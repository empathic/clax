load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@npm_pi//:defs.bzl", "npm_link_all_packages")
load("//bazel/js:defs.bzl", "npm_script_test")

# The Pi extension under Bazel (docs/bazel.md, "The web side and Pi"): its
# packages from pnpm-lock.yaml, and its files beside them in bazel-bin, so
# the real Pi the Rust tests run (crates/clax-testkit/src/clients.rs)
# resolves its imports there.

npm_link_all_packages(name = "node_modules")

exports_files([
    "pnpm-lock.yaml",
    "package.json",
    "pnpm-workspace.yaml",
])

copy_to_bin(
    name = "files",
    srcs = glob(
        [
            "src/**",
            "skills/**",
            "scripts/**",
            "test/**",
        ],
        exclude = ["**/.qual"],
    ) + [
        "README.md",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)

# The files clax embeds (//plugins:embedded).
filegroup(
    name = "embedded",
    srcs = glob(
        [
            "src/**",
            "skills/**",
            "scripts/**",
        ],
        exclude = ["**/.qual"],
    ) + [
        "README.md",
        "package.json",
    ],
    visibility = ["//visibility:public"],
)

# clax-embedded's compile inputs include generated directories (the web
# builds), so rules_rust places its sources in bazel-bin, and its
# include_str!s of files outside the crate resolve there: these are those
# files, copied beside it.
copy_to_bin(
    name = "embedded_bin",
    srcs = [":embedded"],
    visibility = ["//visibility:public"],
)

# The shared contract fixture the Rust tests read.
filegroup(
    name = "test_fixtures",
    srcs = glob(["test/fixtures/**"]),
    visibility = ["//crates:__subpackages__"],
)

# pnpm run typecheck and test. The tests start the warmed clax.
npm_script_test(
    name = "typecheck",
    data = [
        ":files",
        ":node_modules",
    ],
    script = "typecheck",
)

npm_script_test(
    name = "test",
    args = ["--reporter=dot"],
    data = [
        ":files",
        ":node_modules",
        "//crates/clax-cli:clax",
        "//crates/clax-cli:clax_warm",
        "//crates/clax-core:toolpath_vectors_bin",
    ],
    env = {"CLAX_TEST_BIN": "$(rootpath //crates/clax-cli:clax)"},
    script = "test",
    # Run where Bazel ran it once (test/daemon-fixture.ts), not copied.
    skips = ["crates/clax-cli/clax"],
)

# The Pi files the release script test copies (scripts/test-release.files).
exports_files(
    glob(
        [
            "README.md",
            "scripts/**",
            "skills/**",
            "test/fixtures/**",
        ],
        exclude = ["**/.qual"],
    ),
    visibility = ["//scripts:__pkg__"],
)
