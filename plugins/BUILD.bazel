load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

# The plugin trees clax embeds (crates/clax-embedded/src/plugins.rs and its
# build script's list), as compile inputs; Pi's is //plugins/pi:embedded.
filegroup(
    name = "embedded",
    srcs = glob(
        [
            "claude-code/**",
            "clax/**",
            "clax-grok/**",
        ],
        exclude = [
            "**/node_modules/**",
            "**/.qual",
        ],
    ) + [
    ],
    visibility = ["//visibility:public"],
)

# clax-embedded's compile inputs include generated directories (the web
# builds), so rules_rust places its sources in bazel-bin, and its
# include_str!s of files outside the crate resolve there: these are those
# files, copied beside it.
copy_to_bin(
    name = "embedded_bin",
    srcs = [":embedded"],
    visibility = ["//visibility:public"],
)

# The plugin files the release script test copies (scripts/test-release.files).
exports_files(
    glob(
        [
            "claude-code/**",
            "clax/**",
            "clax-grok/**",
        ],
        exclude = ["**/.qual"],
    ),
    visibility = ["//scripts:__pkg__"],
)
