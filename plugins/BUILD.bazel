load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

# The plugin trees clax embeds (crates/clax-cli/src/plugins.rs and its
# build script's list), as compile inputs; Pi's is //plugins/pi:embedded.
filegroup(
    name = "embedded",
    srcs = glob(
        [
            "claude-code/**",
            "clax/**",
            "clax-grok/**",
        ],
        exclude = [
            "**/node_modules/**",
            "**/.qual",
        ],
    ) + [
    ],
    visibility = ["//visibility:public"],
)

# A crate whose compile inputs include a generated directory has its sources
# placed in bazel-bin by rules_rust, so its include_str!s of files outside
# the crate resolve there: these are those files, copied beside it.
copy_to_bin(
    name = "embedded_bin",
    srcs = [":embedded"],
    visibility = ["//visibility:public"],
)
