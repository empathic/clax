# The macros every crate's BUILD file loads (cargo.bzl).

# Bazel's default compilation mode: unoptimized, no debug information.
config_setting(
    name = "fastbuild",
    values = {"compilation_mode": "fastbuild"},
    visibility = ["//visibility:public"],
)

# rules_rust's patch (MODULE.bazel), and the rustfmt check of Rust sources
# no Bazel Rust target holds (crates/clax-worker/BUILD.bazel).
exports_files([
    "rules_rust.patch",
    "rustfmt_check.sh",
])
