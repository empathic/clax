load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

# Running a pnpm project's own scripts under Bazel (defs.bzl).
copy_to_bin(
    name = "runner",
    srcs = ["npm_script.mjs"],
    visibility = ["//visibility:public"],
)

# What the runner imports: where its private copy may go (scratch.mjs) and
# how it is made (project-copy.mjs).
copy_to_bin(
    name = "runner_lib",
    srcs = [
        "project-copy.mjs",
        "scratch.mjs",
    ],
    visibility = ["//visibility:public"],
)

# node --test bazel/js/scratch.test.mjs, as a Bazel test.
js_test(
    name = "scratch_test",
    data = [":runner_lib"],
    entry_point = "scratch.test.mjs",
    node_options = ["--test"],
    patch_node_fs = False,
)

# node --test bazel/js/project-copy.test.mjs, as a Bazel test.
js_test(
    name = "project_copy_test",
    data = [":runner_lib"],
    entry_point = "project-copy.test.mjs",
    node_options = ["--test"],
    patch_node_fs = False,
)
