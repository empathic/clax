diff --git a/rules.bzl b/rules.bzl
--- a/rules.bzl
+++ b/rules.bzl
@@ -23,7 +23,21 @@ def _android_ndk_repository_impl(ctx):
     Returns:
         A final dict of configuration attributes and values.
     """
-    ndk_path = ctx.attr.path or ctx.getenv("ANDROID_NDK_HOME", None)
+    if ctx.attr.urls:
+        # Fetched by checksum, as a hermetic toolchain (a patch Clax keeps:
+        # bazel/android/rules_android_ndk.patch).
+        key = {"linux": "linux", "mac os x": "darwin"}.get(ctx.os.name)
+        if key not in ctx.attr.urls:
+            fail("No NDK archive is pinned for %s" % ctx.os.name)
+        ctx.download_and_extract(
+            url = ctx.attr.urls[key],
+            sha256 = ctx.attr.sha256s.get(key, ""),
+            stripPrefix = ctx.attr.strip_prefix,
+            output = "_ndk",
+        )
+        ndk_path = str(ctx.path("_ndk"))
+    else:
+        ndk_path = ctx.attr.path or ctx.getenv("ANDROID_NDK_HOME", None)
     if not ndk_path:
         fail("Either the ANDROID_NDK_HOME environment variable or the " +
              "path attribute of android_ndk_repository must be set.")
@@ -47,6 +61,7 @@ def _android_ndk_repository_impl(ctx):
     sysroot_directory = "%s/sysroot" % clang_directory
 
     _create_symlinks(ctx, ndk_path, clang_directory, sysroot_directory)
+    _link_cxx_runtimes(ctx, ndk_path, sysroot_directory)
 
     api_level = ctx.attr.api_level or 31
 
@@ -124,16 +139,33 @@ def _create_symlinks(ctx, ndk_path, clang_directory, sysroot_directory):
     # TODO(#32): Remove this hack
     ctx.symlink(ndk_path + "sources", "ndk/sources")
 
+# The C++ runtime archives, each target's in a directory of its own. rules_rust
+# passes `-L` for the directory of the toolchain's static runtime libraries,
+# and the NDK's usr/lib/<target> also holds libc.a: an executable linked with
+# that directory first gets the static libc instead of the API level's
+# libc.so (a patch Clax keeps: bazel/android/rules_android_ndk.patch).
+def _link_cxx_runtimes(ctx, ndk_path, sysroot_directory):
+    if not ndk_path.endswith("/"):
+        ndk_path = ndk_path + "/"
+    for target in ["aarch64-linux-android", "arm-linux-androideabi", "i686-linux-android", "x86_64-linux-android"]:
+        for lib in ["libc++_static.a", "libc++abi.a", "libandroid_support.a"]:
+            src = ctx.path("%s%s/usr/lib/%s/%s" % (ndk_path, sysroot_directory, target, lib))
+            if src.exists:
+                ctx.symlink(src, "%s/cxx_runtime/%s/%s" % (sysroot_directory, target, lib))
+
 android_ndk_repository = repository_rule(
     attrs = {
         "path": attr.string(),
         "api_level": attr.int(),
+        "urls": attr.string_dict(doc = "The NDK's archive by host OS (`darwin`, `linux`)."),
+        "sha256s": attr.string_dict(doc = "Each archive's SHA-256, by host OS."),
+        "strip_prefix": attr.string(),
         "_build": attr.label(default = ":BUILD", allow_single_file = True),
         "_template_ndk_root": attr.label(default = ":BUILD.ndk_root.tpl", allow_single_file = True),
         "_template_target_systems": attr.label(default = ":target_systems.bzl.tpl", allow_single_file = True),
         "_template_ndk_clang": attr.label(default = ":BUILD.ndk_clang.tpl", allow_single_file = True),
         "_template_ndk_sysroot": attr.label(default = ":BUILD.ndk_sysroot.tpl", allow_single_file = True),
     },
-    local = True,
+    # Not local: a pinned archive is fetched once, as any download is.
     implementation = _android_ndk_repository_impl,
 )
