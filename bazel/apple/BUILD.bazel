# Rust static libraries for the iOS app, and their checks (ios_rust.bzl).

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":ios_rust.bzl", "ios_platform_probe")

# rules_apple's patch (MODULE.bazel).
exports_files(["rules_apple.patch"])

# Every Mach-O object of an archive built for one platform and minimum OS.
sh_binary(
    name = "check_build_version",
    srcs = ["check-build-version.sh"],
    visibility = ["//visibility:public"],
)

# The check against objects compiled for iOS, the simulator and macOS at
# chosen minimums (Xcode's clang).
sh_test(
    name = "check_build_version_test",
    srcs = ["check-build-version.test.sh"],
    args = ["$(rootpath :check-build-version.sh)"],
    data = ["check-build-version.sh"],
    target_compatible_with = ["@platforms//os:macos"],
)

ios_platform_probe(
    name = "ios_platform_probe",
    visibility = ["//visibility:public"],
)

# The signing inputs' repository (signing.bzl) against fake directories:
# complete, missing a file, and readable by others; then this machine's
# own directory, when it exists (so it is `external`: never cached). It
# runs Bazel on a scratch workspace with an output base of its own (BAZEL
# names the binary, else bazelisk is looked for on PATH and in the usual
# install directories).
sh_test(
    name = "signing_test",
    srcs = ["signing-test.sh"],
    args = [
        "$(rootpath :signing.bzl)",
        "$(rootpath //:.bazelversion)",
    ],
    data = [
        "signing.bzl",
        "//:.bazelversion",
    ],
    env_inherit = [
        "BAZEL",
        "HOME",
    ],
    tags = [
        "external",
        "manual",
        "no-remote",
        "no-sandbox",
    ],
)
