# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# The embedded core for macOS and Android (libclax_embed), placed by
# scripts/build-app-clax.sh
/build-native/
/android/app/src/main/jniLibs/

# The home bundle, packed by scripts/build-home-bundle.sh for a native build
# (Bazel builds it as //apps/clax_app:home_bundle)
/assets/home/home.clax
/assets/home/release.json
