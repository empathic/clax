<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Claude API, which the embedded core and the app reach over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- On-device dictation. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Dictation's start and stop cues vibrate through the Vibrator
         (CuesChannel.kt), felt even with system touch feedback off. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Runs keep going while the person is elsewhere: BackgroundRunService
         is a dataSync foreground service, and it and the "is ready" notices
         need POST_NOTIFICATIONS to be seen (asked for at the first make). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The notify capability's reminders (flutter_local_notifications) are
         inexact alarms allowed while idle, so no exact-alarm permission;
         they are scheduled again after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- The location capability (geolocator), asked at its first use. No
         CAMERA: the camera capability uses the system camera app through
         image_picker, which needs none (declaring it would require it). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- enableOnBackInvokedCallback: predictive back. Android 13+ shows
         the back-to-home animation, and Flutter's routes follow the back
         gesture (PredictiveBackPageTransitionsBuilder in lib/ui/theme.dart);
         an app screen keeps a back for its page's own history (AppScreen's
         PopScope). dataExtractionRules (Android 12 and later) and
         fullBackupContent (earlier) leave the core's run files and
         flutter_secure_storage's preferences out of backup and device
         transfer (res/xml/data_extraction_rules.xml). -->
    <application
        android:label="Clax"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:name=".ClaxApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- LaunchTheme (Theme.Clax.Starting) is the splash screen, the
                 Clax mark on the brand's background, shown while the process
                 starts; NormalTheme (Theme.Clax) is the window behind the
                 Flutter UI once it runs (res/values/styles.xml). -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Links reach Dart on the bundles channel (BundleIntake.kt),
                 never as a route Flutter would push from the intent's data. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- App bundles (.clax) opened or shared to Clax, and Get in Clax
             links. This invisible, history-less activity forwards each file
             or link to the one MainActivity in Clax's own task
             (BundleReceiverActivity.kt), so the sender's task never starts a
             second engine; BundleIntake.kt copies a file and hands it, or
             the link, to Dart. Messaging apps label an unknown file
             application/octet-stream, and a .clax is a zip; the reader
             refuses a file that is not a bundle. A SEND carries its file in
             EXTRA_STREAM, not in the intent's data, so its filter names no
             scheme (one would stop every share from matching). -->
        <activity
            android:name=".BundleReceiverActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/vnd.empathic.clax+zip"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.empathic.clax+zip"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!-- Get in Clax on clax.dev, https://clax.dev/a/<id>/get: an app
                 link Android verifies against clax.dev's
                 /.well-known/assetlinks.json, which must name this app's
                 signing certificate; unverified, Android 12 and later open
                 it in the browser (earlier versions ask which app opens
                 it). Kept apart from the clax: filter, as Android
                 verifies only a filter whose schemes are all http(s).
                 The path has one "." (any one character) for each of an
                 artifact ID's twelve: ".*" would also cross "/" and take
                 /a/<id>/v/<n>/get, a page file named get, which the app
                 does not open. pathPattern has no class that excludes
                 "/" (pathAdvancedPattern needs API 31), and at this
                 length no other path fits. The site association's path
                 (crates/clax-server/src/shell/get_page.rs) is the same. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="clax.dev"/>
                <data android:pathPattern="/a/............/get"/>
            </intent-filter>
            <!-- clax:get?url=<artifact URL>: Get in Clax from any hosted
                 Clax. Dart's BundleIntakeEvent.artifactOf decides what such
                 a link may name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="clax"/>
            </intent-filter>
        </activity>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <service
            android:name=".BackgroundRunService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- speech_to_text finds the device's recognizer through this. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
