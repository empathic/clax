    name = "icon_outputs",
    srcs = glob(
        [
            "android/app/src/main/res/drawable/ic_launcher_*.xml",
            "android/app/src/main/res/mipmap-*/ic_launcher*",
            "android/app/src/main/res/values/ic_launcher_colors.xml",
            "icons/**",
            "macos/Runner/AppIcon.icon/**",
            "macos/Runner/Assets.xcassets/AppIcon.appiconset/**",
        ],
        exclude = ["**/.qual"],
    ),
    visibility = [
        "//design:__pkg__",
        "//scripts:__pkg__",
    ],
)

# What scripts/sync-tokens.py writes into the app (design/tokens.json), and
# the stylesheets whose color-mix() guards it checks, for its checks
