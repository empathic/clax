# The home app's bundle, assets/home/home.clax, and its release record,
# assets/home/release.json, packed from home/ and the kit files its manifest
# names by tool/pack_home.dart (which needs only the bundle format and no
# Flutter), at the version and with the key of this machine's home release
# (bazel/flutter/home_release.bzl): the app's assets, so the APK and the
# macOS app carry the bundle of their own sources. Built locally: the key
# is this machine's.
dart_library(
    name = "bundle_format",
    package_name = "clax_app",
    srcs = [
        "lib/agent/icon_svg.dart",
        "lib/bundle/bundle_reader.dart",
        "lib/bundle/bundle_writer.dart",
        "lib/bundle/content_hash.dart",
        "lib/bundle/manifest.dart",
        "lib/bundle/signing.dart",
    ],
    deps = [
        "@clax_app_pub//:archive",
        "@clax_app_pub//:cryptography",
        "@clax_app_pub//:xml",
    ],
)

dart_binary(
    name = "pack_home",
    main = "tool/pack_home.dart",
    deps = [":bundle_format"],
)

genrule(
    name = "home_bundle",
    srcs = glob(
        [
            "assets/kit/**",
            "home/**",
        ],
        exclude = ["**/.qual"],
    ) + [
        "@clax_home_release//:key",
        "@clax_home_release//:mode",
        "@clax_home_release//:version",
    ],
    outs = [
        "assets/home/home.clax",
        "assets/home/release.json",
    ],
    cmd = """
        dev=""
        if [ "$$(cat $(location @clax_home_release//:mode))" = dev ]; then dev=--dev; fi
        $(execpath :pack_home) --app apps/clax_app \
            --key $(location @clax_home_release//:key) \
            --version "$$(cat $(location @clax_home_release//:version))" \
            --out $(RULEDIR)/assets/home $$dev > /dev/null
    """,
    tags = ["no-remote"],
    tools = [":pack_home"],
)

# The version the home bundle takes (tool/home-version.sh): the same while
# its sources are, higher whenever they change.
sh_test(
    name = "home_version_test",
    srcs = ["tool/home-version-test.sh"],
    args = ["$(rootpath tool/home-version.sh)"],
    data = ["tool/home-version.sh"],
)

# The macOS integration tests (`flutter test integration_test/<name>_test.dart
# -d macos`), a target per file but the iOS ones (`ios_*`),
# //apps/clax_app:integration_<name>: the
# debug app with the test as its entry point and the embedded clax, run in
# the logged-in session. They open the app's window and take minutes, so
# they are `manual`: `just app-integration` runs them. A test's entry in
# INTEGRATION_EXTRA adds launch arguments, data and environment.
INTEGRATION_EXTRA = {
    # The window chrome test: its menu golden, and a purple system accent
    # (System Settings › Appearance's, for this launch only), so its renders
    # show whether the Apple family follows the accent.
    "mac_chrome": {
        "args": [
            "-AppleAccentColor",
            "5",
        ],
        "data": ["integration_test/goldens/main_menu.txt"],
        "env": {"CLAX_MENU_GOLDEN": "$(rootpath integration_test/goldens/main_menu.txt)"},
    },
}

[
    (
        integration_main(
            name = "_integration_%s_main" % test[len("integration_test/"):-len("_test.dart")],
            srcs = glob(["integration_test/*.dart"]),
            test = test,
            tags = ["manual"],
        ),
        flutter_application(
            name = "_integration_%s_app" % test[len("integration_test/"):-len("_test.dart")],
            package_name = "clax_app",
            srcs = glob(["lib/**/*.dart"]) + [":_integration_%s_main" % test[len("integration_test/"):-len("_test.dart")]],
            assets = APP_ASSETS,
            main = ":_integration_%s_main.dart" % test[len("integration_test/"):-len("_test.dart")],
            tags = ["manual"],
            deps = [
                ":clax_app",
                "@clax_app_pub//:flutter_test",
                "@clax_app_pub//:integration_test",
                "@rules_flutter//flutter:material_icons",
            ],
        ),
        flutter_macos_app(
            name = "_integration_%s_macos" % test[len("integration_test/"):-len("_test.dart")],
            additional_contents = {":macos_clax": "Resources"},
            app_name = "Clax",
            application = ":_integration_%s_app" % test[len("integration_test/"):-len("_test.dart")],
            bundle_id = "dev.empathic.clax",
            info_plist = ":macos_info_plist",
            tags = ["manual"],
            version = ":macos_version",
        ),
        debug_app(
            name = "_integration_%s_debug" % test[len("integration_test/"):-len("_test.dart")],
            app = ":_integration_%s_macos" % test[len("integration_test/"):-len("_test.dart")],
            tags = ["manual"],
        ),
        sh_test(
            name = "integration_%s" % test[len("integration_test/"):-len("_test.dart")],
            timeout = "long",
            srcs = ["tool/integration-run.sh"],
            args = ["$(rootpath :_integration_%s_debug)" % test[len("integration_test/"):-len("_test.dart")]] +
                   INTEGRATION_EXTRA.get(test[len("integration_test/"):-len("_test.dart")], {}).get("args", []),
            data = [":_integration_%s_debug" % test[len("integration_test/"):-len("_test.dart")]] +
                   INTEGRATION_EXTRA.get(test[len("integration_test/"):-len("_test.dart")], {}).get("data", []),
            env = INTEGRATION_EXTRA.get(test[len("integration_test/"):-len("_test.dart")], {}).get("env", {}),
            tags = [
                "exclusive",
                "manual",
                "no-remote",
                "no-sandbox",
            ],
            target_compatible_with = ["@platforms//os:macos"],
        ),
    )
    for test in glob(
        ["integration_test/*_test.dart"],
        exclude = ["integration_test/ios_*_test.dart"],
    )
]
