# NOTICES, which the app bundles as NOTICES.Z for its licences page
# (bazel/flutter/notices.bzl): the pub packages', the Flutter engine's and
# the embedded clax's Rust crates' licences.
flutter_notices(
    name = "notices",
    hub = "clax_app_pub",
    # flutter_web_plugins, part of the Flutter SDK, has no LICENSE of its
    # own: the SDK's (package:flutter's) covers it.
    pub_licenses = pub_licenses(
        "clax_app_pub",
        APP_PUB_PACKAGES,
        license_of = {"flutter_web_plugins": "flutter"},
    ),
    engine_license = "@flutter_sky_engine//sky_engine:LICENSE",
    rust_binaries = [
        "//crates/clax-cli:clax_android_arm64",
        "//crates/clax-cli:clax_android_x86_64",
        "//crates/clax-cli:clax_opt",
    ],
    deps = [":clax_app"],
)

# The files whose user-facing copy scripts/check-copy.py checks
# (//scripts:check_copy): the app's screens, the home app and the kit.
# The kit's vendored bundles (preact.js, dates.js) are left out.
filegroup(
    name = "copy_sources",
    srcs = glob(
        [
            "assets/kit/*.js",
            "home/*.js",
            "lib/agent/failure.dart",
            "lib/app.dart",
            "lib/home/**/*.dart",
            "lib/ui/**/*.dart",
        ],
        exclude = [
            "assets/kit/dates.js",
            "assets/kit/preact.js",
            "lib/ui/tokens.g.dart",
        ],
    ),
    visibility = ["//scripts:__pkg__"],
)

flutter_application(
    name = "app",
    package_name = "clax_app",
    srcs = glob(["lib/**/*.dart"]),
    assets = APP_ASSETS,
    license_files = [":notices"],
    main = "lib/main.dart",
    deps = [
        ":clax_app",
        "@rules_flutter//flutter:material_icons",
    ],
)

# pubspec.yaml's `version: <name>+<code>`.
VERSION_NAME = "1.0.0"

VERSION_CODE = "1"

sh_test(
    name = "version_sync",
    srcs = ["tool/version-sync.sh"],
    args = [
        VERSION_NAME,
        VERSION_CODE,
    ],
    data = ["pubspec.yaml"],
)

# The app's LICENSE, its licences page's Clax entry, carries the text of
# LICENSES/GPL-2.0-only.txt.
sh_test(
    name = "licence_check",
    srcs = ["tool/licence-check.sh"],
    data = [
        "LICENSE",
        "//:LICENSES/GPL-2.0-only.txt",
    ],
)

# The release APK, for both Android CPUs the app ships, with the embedded
# clax for each (bazel/flutter/android.bzl).
flutter_fat_apk(
    name = "apk",
    application = ":app",
    debug_key = "@android_debug_keystore//:key",
    kotlin_srcs = glob(["android/app/src/main/kotlin/**/*.kt"]),
    manifest = "android/app/src/main/AndroidManifest.xml",
    # As android/app/build.gradle.kts gives them: minSdk 29, Flutter's
    # target SDK, and pubspec.yaml's version (:version_sync checks it).
    manifest_values = {
        "minSdkVersion": "29",
        "targetSdkVersion": "36",
        "versionCode": VERSION_CODE,
        "versionName": VERSION_NAME,
    },
    namespace = "dev.empathic.clax_app",
    native_files = {
        "//crates/clax-cli:clax_android_arm64": "arm64-v8a/libclax.so",
        "//crates/clax-cli:clax_android_x86_64": "x86_64/libclax.so",
    },
    package_name = "dev.empathic.clax",
    # Shrunk with R8 as Gradle's release build is: AGP's optimized defaults
    # and Flutter's rules; each plugin's and library's own rules come with it.
    proguard_specs = [
        "//bazel/android:proguard-android-optimize.txt",
        "//bazel/flutter:flutter_proguard_rules.pro",
    ],
    pub_hub_name = "clax_app_pub",
    resources = glob(
        ["android/app/src/main/res/**"],
        exclude = ["**/.qual"],
    ),
    # As android/app/build.gradle.kts's dependencies give them.
    runner_deps = ["@rules_android_maven//:androidx_core_core_splashscreen"],
    shrink_resources = 1,
    tags = ["no-remote"],
)

# The APK has what the Gradle build gives it (tool/apk-check.sh).
sh_test(
    name = "apk_test",
    srcs = ["tool/apk-check.sh"],
    args = [
        "$(rootpath :apk)",
        "$(rootpath @androidsdk//:aapt2)",
        "$(rootpath @androidsdk//:apksigner)",
        "$(rootpath :assets/home/home.clax)",
    ],
    data = [
        ":apk",
        ":assets/home/home.clax",
        "@androidsdk//:aapt2",
        "@androidsdk//:apksigner",
    ],
    env = {
        "VERSION_CODE": VERSION_CODE,
        "VERSION_NAME": VERSION_NAME,
    },
    tags = ["no-remote"],
)

# apk-check.sh's reading of MainActivity's configChanges, without an APK.
sh_test(
    name = "apk_check_test",
    srcs = ["tool/apk-check-test.sh"],
    args = ["$(rootpath tool/apk-check.sh)"],
    data = ["tool/apk-check.sh"],
)

# The macOS app, with the optimized host clax in its Resources, where the
# app's supervisor starts it (lib/daemon/supervisor.dart), signed as a
# sandboxed helper (bazel/flutter/macos.bzl).
macos_helper(
    name = "macos_clax",
    binary = "//crates/clax-cli:clax_opt",
    # A debug app is not sandboxed: its helper is signed without them.
    entitlements = select({
        ":dbg": None,
        "//conditions:default": "macos/Runner/ClaxHelper.entitlements",
    }),
)

config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
)

# pubspec.yaml's version, as Flutter's Xcode build gives it to the bundle.
apple_bundle_version(
    name = "macos_version",
    build_version = VERSION_CODE,
    short_version_string = VERSION_NAME,
)

# The Runner's Info.plist with the copyright of
# macos/Runner/Configs/AppInfo.xcconfig, as the Xcode build fills it in.
genrule(
    name = "macos_info_plist",
    srcs = [
        "macos/Runner/Configs/AppInfo.xcconfig",
        "macos/Runner/Info.plist",
    ],
    outs = ["macos_info_plist/Info.plist"],
    cmd = "$(location tool/macos-info-plist.sh) $(location macos/Runner/Info.plist) $(location macos/Runner/Configs/AppInfo.xcconfig) $@",
    tools = ["tool/macos-info-plist.sh"],
)

flutter_macos_app(
    name = "macos_app",
    additional_contents = {":macos_clax": "Resources"},
    # The Xcode build's PRODUCT_NAME (macos/Runner/Configs/AppInfo.xcconfig).
    app_name = "Clax",
    application = ":app",
    bundle_id = "dev.empathic.clax",
    info_plist = ":macos_info_plist",
    version = ":macos_version",
)

# The app's zip: `$(rootpath :macos_app)` names its launcher script.
filegroup(
    name = "macos_app_zip",
    srcs = [":macos_app"],
    tags = ["manual"],
)

# The macOS app has what the Xcode build gives it (tool/macos-app-check.sh).
sh_test(
    name = "macos_app_test",
    srcs = ["tool/macos-app-check.sh"],
    args = [
        "$(rootpath :macos_app_zip)",
        "$(rootpath :assets/home/home.clax)",
        "$(rootpath macos/Runner/DebugProfile.entitlements)",
    ],
    data = [
        "macos/Runner/DebugProfile.entitlements",
        ":assets/home/home.clax",
        ":macos_app_zip",
    ],
    env = {
        "VERSION_CODE": VERSION_CODE,
        "VERSION_NAME": VERSION_NAME,
    },
    tags = ["no-remote"],
    target_compatible_with = ["@platforms//os:macos"],
)

# The iOS app (iPhone and iPad) with the daemon in its own process
