# The Clax app (Flutter). Its kit and home app are web files the browser
# tests also load (web/e2e/home-app.spec.ts, lockdown.spec.ts, map.spec.ts),
# as js_library targets so rules_js copies them beside the tests.

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_analysis_test", "dart_binary", "dart_library")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_library", "flutter_test")
load("@rules_flutter//flutter:macos.bzl", "flutter_macos_app")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("//bazel/flutter:android.bzl", "flutter_fat_apk")
load("//bazel/flutter:ios.bzl", "clax_ios_app", "clax_ios_integration_tests")
load("//bazel/flutter:macos.bzl", "debug_app", "integration_main", "macos_helper")
load("//bazel/flutter:notices.bzl", "flutter_notices", "pub_licenses")
load("//bazel/flutter:tests.bzl", "flutter_test_suite")

js_library(
    name = "kit",
    srcs = glob(
        ["assets/kit/**"],
        exclude = ["**/.qual"],
    ),
    visibility = ["//web:__pkg__"],
)

js_library(
    name = "home",
    srcs = glob(
        ["home/**"],
        exclude = ["**/.qual"],
    ),
    visibility = ["//web:__pkg__"],
)

js_library(
    name = "home_unit",
    srcs = glob(
        ["home_unit/**"],
        exclude = ["**/.qual"],
    ),
    visibility = ["//web:__pkg__"],
)
exports_files(["pubspec.lock"])

# `flutter analyze`'s rules for the app's Dart targets (the dart_analyze
# aspect .bazelrc applies to every test run).
dart_analysis_options(
    name = "analysis_options",
    src = "analysis_options.yaml",
    deps = ["@clax_app_pub//:flutter_lints"],
)

dart_analysis_config(
    name = "analysis_config",
    options = [":analysis_options"],
    visibility = ["//visibility:public"],
)

flutter_library(
    name = "clax_app",
    package_name = "clax_app",
    srcs = glob(["lib/**/*.dart"]),
    tags = ["no-dart-format"],
    deps = [
        "@clax_app_pub//:archive",
        "@clax_app_pub//:cryptography",
        "@clax_app_pub//:file_picker",
        "@clax_app_pub//:flutter",
        "@clax_app_pub//:flutter_local_notifications",
        "@clax_app_pub//:flutter_secure_storage",
        "@clax_app_pub//:flutter_svg",
        "@clax_app_pub//:flutter_timezone",
        "@clax_app_pub//:geolocator",
        "@clax_app_pub//:image_picker",
        "@clax_app_pub//:path_provider",
        "@clax_app_pub//:share_plus",
        "@clax_app_pub//:speech_to_text",
        "@clax_app_pub//:timezone",
        "@clax_app_pub//:webview_flutter",
        "@clax_app_pub//:webview_flutter_wkwebview",
        "@clax_app_pub//:xml",
    ],
)

# The app's unit and widget tests (`flutter test`), a test target per file,
# //apps/clax_app:<dir>_<file>, each run in a flutter_tester of its own and
# compiled with the other files of its directory (bazel/flutter/tests.bzl
# says why), against the app's sources and the files its tests read. The
# *_real_test.dart files, which run the real daemon, form a suite of their
# own with the warmed debug clax.
TEST_SUPPORT = glob(
    [
        "test/**/*.dart",
        "tool/**/*.dart",
    ],
    exclude = ["test/**/*_test.dart"],
) + [
    # Test files other tests import for their fakes.
    "test/platform/background_work_test.dart",
    "test/platform/device/device_host_test.dart",
    "test/ui/build_view_test.dart",
    "test/ui/bundle_flows_test.dart",
    # The integration rig's pure helpers, which a unit test runs.
    "integration_test/newer.dart",
]

TEST_DATA = glob(
    [
        "assets/**",
        "home/**",
        "test/fixtures/**",
        "tool/eval/prompts.json",
    ],
    # assets/home holds the home bundle, :home_bundle builds it (a native
    # build packs it there too: scripts/build-home-bundle.sh).
    exclude = [
        "**/.qual",
        "assets/home/**",
    ],
) + [
    ":home_bundle",
    "pubspec.yaml",
    # The icon rule vectors the core runs too (test/agent/icon_fixtures_test.dart).
    "//crates/clax-core:icon_fixtures",
    "//web:contract_files",
]

REAL_TESTS = glob(["test/**/*_real_test.dart"])

# {suite: its test files}: a directory's, the top level's, and the real ones.
SUITES = {
    "real": REAL_TESTS,
    "root": glob(
        ["test/*_test.dart"],
        exclude = REAL_TESTS,
    ),
} | {
    d: glob(
        ["test/%s/**/*_test.dart" % d],
        exclude = REAL_TESTS,
    )
    for d in [
        "agent",
        "bundle",
        "clax",
        "daemon",
        "eval",
        "home",
        "platform",
        "ui",
    ]
}

[flutter_test_suite(
    name = "tests_%s" % suite,
    size = "medium",
    package_name = "clax_app",
    srcs = TEST_SUPPORT,
    assets = glob(
        [
            "assets/kit/**",
            "assets/prompt/**",
        ],
        exclude = ["**/.qual"],
    ) + [
        "LICENSE",
        "assets/haiku.json",
        ":home_bundle",
    ],
    data = TEST_DATA + ([
        "//crates/clax-cli:clax",
        "//crates/clax-cli:clax_warm",
    ] if suite == "real" else []),
    # APP_NAME, as `flutter test` sets it beside UNIT_TEST_ASSETS
    # (flutter_test_suite): flutter_test then reads an asset from disk at
    # once, where through the engine the read would not finish within a
    # test's fake time.
    env = {"APP_NAME": "clax_app"} | ({"CLAX_TEST_BIN": "crates/clax-cli/clax"} if suite == "real" else {}),
    license_files = [":notices"],
    names = {t: t[len("test/"):-len(".dart")].replace("/", "_") for t in files},
    tests = files,
    deps = [
        ":clax_app",
        "@clax_app_pub//:flutter_test",
    ],
) for suite, files in SUITES.items() if files]

# A test file in no suite would never run.
[fail("%s is in no suite of SUITES (apps/clax_app/BUILD.bazel): add its directory" % t) for t in glob(["test/**/*_test.dart"]) if not [s for s in SUITES.values() if t in s]]

# `flutter analyze` (analysis_options.yaml) over the app's Dart: its
# library, and its tests, integration tests and tools as a library of their
# own, which nothing compiles but the analysis. No format check: the app's
# code is not `dart format`ted.
flutter_library(
    name = "checked_sources",
    package_name = "clax_app",
    srcs = glob([
        "integration_test/*.dart",
        "test/**/*.dart",
        "tool/**/*.dart",
    ]),
    tags = [
        "manual",
        "no-dart-format",
    ],
    deps = [
        ":clax_app",
        "@clax_app_pub//:archive",
        "@clax_app_pub//:cryptography",
        "@clax_app_pub//:flutter_test",
        "@clax_app_pub//:integration_test",
        "@clax_app_pub//:xml",
    ],
)

dart_analysis_test(
    name = "dart_analyze",
    targets = [
        ":checked_sources",
        ":clax_app",
    ],
)

# The prompt's copies of the contract match it (scripts/sync-app-prompt.sh).
sh_test(
    name = "prompt_sync",
    srcs = ["//scripts:sync-app-prompt.sh"],
    args = ["--check"],
    data = glob(["assets/prompt/**"]) + [
        "//docs:contract",
        "//web:contract_files",
    ],
)

# pubspec.yaml's assets: the files directly in each directory it names, as
# Flutter bundles them; assets/home's are the built home bundle.
APP_ASSETS = glob(
    [
        "assets/kit/*",
        "assets/prompt/*",
    ],
    exclude = ["**/.qual"],
) + [
    "LICENSE",
    "assets/haiku.json",
    ":home_bundle",
]

