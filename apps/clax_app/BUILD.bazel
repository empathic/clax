filegroup(
    name = "token_outputs",
    srcs = [
        "assets/haiku.json",
        "assets/kit/kit.css",
        "assets/kit/map.js",
        "home/home.css",
        "home/mark.css",
        "home/tokens.css",
        "lib/ui/tokens.g.dart",
    ],
    visibility = [
        "//design:__pkg__",
        "//scripts:__pkg__",
    ],
)

