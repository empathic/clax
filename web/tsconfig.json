{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true, "types": ["vite/client", "node", "chrome"],
    "baseUrl": ".", "paths": {
      "clax-bridge-parts": ["bridge/src/parts-url.ts"],
      "@empathic/clax-sdk": ["sdk/src/index.ts"],
      "@empathic/clax-sdk/overlay": ["overlay/src/main.ts"],
      "@empathic/clax-sdk/*": ["sdk/src/*.ts"]
    }
  },
  "include": ["shell/src", "shell/test-setup.ts", "bridge/src", "bridge/test", "extension", "sdk", "overlay", "e2e", "perf", "reel", "scripts"]
}
