load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@npm_web//:defs.bzl", "npm_link_all_packages")
load("@npm_web//web:@playwright/test/package_json.bzl", playwright_bin = "bin")
load("//bazel:dirs.bzl", "pick_dir")
load("//bazel/js:defs.bzl", "npm_script_build", "npm_script_test")

# The web UI under Bazel (docs/bazel.md, "The web side and Pi"): its
# package.json scripts, run over the whole project with packages from
# pnpm-lock.yaml.

npm_link_all_packages(name = "node_modules")

exports_files([
    "pnpm-lock.yaml",
    "package.json",
    "pnpm-workspace.yaml",
])

# The project's own files, where the tools run, in two parts that do not
# overlap: what the build reads, and the tests. An edit to a test, a browser
# test or a benchmark then rebuilds no web UI, and so recompiles no Rust that
# embeds it.
APP_DIRS = [
    "shell/**",
    "bridge/**",
    "extension/**",
    "contract/**",
    "scripts/**",
    "quickstart/**",
]

TEST_FILES = [
    "**/*.test.ts",
    "bridge/test/**",
    "extension/test/**",
    "shell/src/test/**",
    "shell/test-setup.ts",
]

copy_to_bin(
    name = "files_app",
    srcs = glob(
        APP_DIRS,
        exclude = TEST_FILES + [
            "**/.qual",
            "extension/key/key.pem",
        ],
    ) + [
        ".oxlintrc.json",
        "package.json",
        "playwright.config.ts",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "tsconfig.json",
        "vite.bridge.config.ts",
        "vite.bridge-parts.config.ts",
        "vite.shell.config.ts",
        "vite.transport.config.ts",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)

copy_to_bin(
    name = "files_tests",
    srcs = glob(
        [d + "/" + t for d in [x[:-len("/**")] for x in APP_DIRS] for t in ["**/*.test.ts"]] + [
            "bridge/test/**",
            "extension/test/**",
            "shell/src/test/**",
            "shell/test-setup.ts",
            "e2e/**",
            "perf/**",
        ],
        exclude = ["**/.qual"],
        # Not every directory has unit tests of its own.
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "files",
    srcs = [
        ":files_app",
        ":files_tests",
    ],
    visibility = ["//visibility:public"],
)

# pnpm run build: the web UI, the extension and the extension's test build.
npm_script_build(
    name = "dist_all",
    srcs = [
        ":files_app",
        ":node_modules",
        "//:cargo_toml",
        "//docs:legal",
    ],
    out_dirs = [
        "dist",
        "dist-extension",
        "dist-extension-test",
    ],
    script = "build",
    visibility = ["//visibility:public"],
)

pick_dir(
    name = "dist",
    dir = "dist",
    src = ":dist_all",
    visibility = ["//visibility:public"],
)

pick_dir(
    name = "dist_extension",
    dir = "dist-extension",
    src = ":dist_all",
    visibility = ["//visibility:public"],
)

pick_dir(
    name = "dist_extension_test",
    dir = "dist-extension-test",
    src = ":dist_all",
    visibility = ["//visibility:public"],
)

# pnpm run build:e2e: the browser tests' web UI, with the test clock.
npm_script_build(
    name = "dist_e2e",
    srcs = [
        ":dist",
        ":files_app",
        ":node_modules",
    ],
    out_dirs = ["dist-e2e"],
    script = "build:e2e",
    visibility = ["//visibility:public"],
)

# What scripts/sync-tokens.py reads from the shell: the haikus it copies
# into the app, and the app-mode colours it checks against design/tokens.json.
filegroup(
    name = "token_inputs",
    srcs = [
        "shell/src/theme.css",
        "shell/src/view/haiku.json",
    ],
    visibility = [
        "//design:__pkg__",
        "//scripts:__pkg__",
    ],
)

# The extension's key directory, which clax-core's build script reads
# (crates/clax-core/build.rs).
filegroup(
    name = "extension_key",
    srcs = glob(["extension/key/key.pub.b64"], allow_empty = True) + ["extension/key/.gitkeep"],
    visibility = ["//crates/clax-core:__pkg__"],
)

# The extension's manifest, which clax-core embeds.
exports_files(
    ["extension/manifest.json"],
    visibility = ["//crates:__subpackages__"],
)

# The shell's and the bridge's files the Rust code and its tests include, to check that both
# sides agree (include_str! in crates/clax-server and crates/clax-commands).
filegroup(
    name = "shell_cases",
    srcs = glob([
        "shell/src/*-cases.json",
        "shell/src/view/frame-host.ts",
        "shell/src/view/haiku.json",
    ]) + [
        "bridge/src/protocol.ts",
        "shell/artifact.html",
    ],
    visibility = ["//crates:__subpackages__"],
)

# The contract files clax-server embeds (src/shell/mod.rs), and the Clax
# app's prompt test compares with its copies.
filegroup(
    name = "contract_files",
    srcs = glob(["contract/**"], exclude = ["**/.qual"]),
    visibility = [
        "//apps/clax_app:__pkg__",
        "//crates:__subpackages__",
    ],
)

# What the unit tests and the typecheck read outside web/: the toolpath
# vectors, the browser tests of the hosted demo (they import demo/lib), the
# home app's modules, its unit tests and the kit (apps/clax_app/home_unit),
# the host relay's scripts for one long answer (relay_fixture), and the
# reel's recorder (web/reel, a package of its own, so no input of :dist).
UNIT_DATA = [
    ":files",
    ":node_modules",
    "//web/reel:files",
    "//apps/clax_app:home",
    "//apps/clax_app:home_unit",
    "//apps/clax_app:kit",
    "//apps/clax_app:relay_fixture",
    "//crates/clax-core:toolpath_vectors_bin",
    "//demo:files",
]

# pnpm run lint, typecheck and test.
npm_script_test(
    name = "lint",
    data = UNIT_DATA,
    script = "lint",
)

npm_script_test(
    name = "typecheck",
    data = UNIT_DATA,
    script = "typecheck",
)

npm_script_test(
    name = "unit",
    args = ["--reporter=dot"],
    data = UNIT_DATA,
    script = "test",
)

# The bundle gate: gzip sizes of the built web UI and extension against
# web/perf/bundle-budget.json (scripts/bundle-size.mjs). Its --record mode
# writes the budget file in the checkout and stays a native command.
npm_script_test(
    name = "bundle_size",
    data = [
        ":dist",
        ":dist_extension",
        ":files",
        ":node_modules",
    ],
    script = "bundle-size",
)

# The browser tests (pnpm run e2e), one target per Playwright project, on
# the pinned Chromium (bazel/playwright) and the warmed clax. The binary and
# the browsers are read where Bazel put them, not copied
# (web/e2e/bazel-env.ts). `e2e_shots` renders the app's web pieces into
# CLAX_SHOTS_DIR (e2e/app-shots.spec.ts) and is run on demand only.
E2E_DATA = [
    "//apps/clax_app:home",
    "//apps/clax_app:kit",
    "//apps/clax_app:relay_fixture",
    ":dist",
    ":dist_e2e",
    ":dist_extension_test",
    ":files",
    ":node_modules",
    "//crates/clax-cli:clax",
    "//crates/clax-cli:clax_warm",
    "//demo:files",
    "@chromium//:browsers",
]

E2E_ENV = {
    "CLAX_GALLERY__QUICKSTART": "false",
    "CLAX_E2E_WEB_DIST": "$(rootpath :dist_e2e)",
    "CLAX_TEST_BIN": "$(rootpath //crates/clax-cli:clax)",
    "PLAYWRIGHT_BROWSERS_PATH": "$(rootpath @chromium//:browsers)",
}

E2E_SKIPS = ["crates/clax-cli/clax"]

[npm_script_test(
    name = "e2e_" + project.replace("-", "_"),
    args = [
        "--project",
        project,
    ],
    data = E2E_DATA,
    env = E2E_ENV | {"CLAX_E2E_WORKERS": "8"},
    skips = E2E_SKIPS,
    # The pinned browsers stay where their repository put them.
    no_copy_to_bin = ["@chromium//:browsers"],
    # Chromium under macOS's sandbox-exec ran the suite about twenty times
    # slower and timed out user-activation tests (docs/bazel.md, "Browser
    # tests"), so the browser tests run outside Bazel's sandbox.
    tags = [
        "cpu:8",
        "no-sandbox",
    ] + (["manual"] if project == "shots" else []),
    script = "e2e",
) for project in [
    "gesture",
    "chrome-overlay",
    "rest",
    "shots",
]]

# Time to usable (pnpm run perf), on demand only (`just perf`): alone; it
# prints each measure beside its budget and fails no check.
npm_script_test(
    name = "perf_usable_full",
    data = E2E_DATA,
    env = E2E_ENV,
    skips = E2E_SKIPS,
    # The pinned browsers stay where their repository put them.
    no_copy_to_bin = ["@chromium//:browsers"],
    tags = [
        "exclusive",
        "manual",
        "no-sandbox",
    ],
    script = "perf",
)

# The locked Playwright command line, for `install-deps` in CI: the
# package's own bin, as rules_js generates it. An entry point named inside
# the package (`:node_modules/@playwright/test/cli.js`) is copied to an
# output under the package's directory output, which Bazel refuses.
playwright_bin.playwright_binary(name = "playwright")
