{"metabox":"1","type":"annotation","subject":"web/e2e/streams.spec.ts","issuer":"mailto:alex@kesling.co","issuer_type":"ai","created_at":"2026-10-10T01:32:59.729504Z","id":"980f4257b517a4f9de109de736d0da13aeeec4707cdbb942f508fc48af2a2b40","body":{"detail":"Under machine load this has failed with a new tab ready in 1121 ms against the 1000 ms budget. Functional tests should not judge time; the time-to-usable perf gate judges these, scaled to the machine.","kind":"concern","span":{"start":{"line":219},"end":{"line":221},"content_hash":"135a23af6a9a60674f0b8cd9042601413ba0379f4e4a0f93698f8f9a27d09033"},"suggested_fix":"Judge the test by the streams the daemon holds (one open stream at the same level, none opened for the new tabs or the publish) and log the times.","summary":"The thirty-tab stream test judges wall-clock budgets (a new tab ready within 1 s, publish-to-tab within 500 ms) and fails under load","tags":["flaky-test","fix-pending:followups-streams-perf-pi","session:claude-code:4661063b-b304-434f-95f6-59a30e211068"]}}
{"metabox":"1","type":"annotation","subject":"web/e2e/streams.spec.ts","issuer":"mailto:alex@kesling.co","issuer_type":"ai","created_at":"2026-10-10T01:32:59.729542Z","id":"76c0610dd30031ed20e78da3f4e5f68c716ab3b97145f2a17398ebb716e52514","body":{"detail":"Seen once under load in a full gates run (2026-10-09). Two streams at the admin level may mean the artifact view reopened its stream after setName() although the daemon's caller had not changed, or a duplicate stream report. Not reproduced alone.","kind":"concern","span":{"start":{"line":164},"end":{"line":164},"content_hash":"f9436d8df90415588dac2b782f216cb960868f780ee32fcca960c799fe98ff81"},"summary":"The no-token stream test once saw stream levels [\"admin\",\"admin\"] where it expects [\"admin\"]","tags":["flaky-test","fix-pending:followups-streams-perf-pi","session:claude-code:4661063b-b304-434f-95f6-59a30e211068"]}}
{"metabox":"1","type":"annotation","subject":"web/e2e/gesture.spec.ts","issuer":"mailto:alex@kesling.co","issuer_type":"ai","created_at":"2026-10-10T01:32:59.731396Z","id":"2c771fe38d3d0645ca5e87c1cabe0466ddc9ecbf9298c9257e4b5441eabf38d7","body":{"detail":"Seen for the sandbox sendToClaude variant under heavy machine load; passed on rerun. The injected frame is now clicked only once it has loaded (this block). Not yet confirmed under a loaded full gates run.","kind":"concern","span":{"start":{"line":1027},"end":{"line":1042},"content_hash":"3a7f1cf15235e08e3ec907d029ed896bbd38bd31a04b5d7a98beae53821c2cb1"},"summary":"The N14 closed-shadow-root case hit a 120 s timeout under load","tags":["flaky-test","session:claude-code:4661063b-b304-434f-95f6-59a30e211068"]}}
{"metabox":"1","type":"annotation","subject":"web/e2e/subpages.spec.ts","issuer":"mailto:alex@kesling.co","issuer_type":"ai","created_at":"2026-10-10T01:32:59.731434Z","id":"99e106564689907ff0dd6bc26b4241f7beaf7f48a38ba39c37d598e83e89fc8c","body":{"detail":"Passed 10 of 10 alone. Not yet diagnosed.","kind":"concern","span":{"start":{"line":171},"end":{"line":193},"content_hash":"62b35d2895462e57af1b55ea3a06b1e7b72ba95c453c781c1b3f1136140cf9ec"},"summary":"'one link inside the frame is one history entry' fails about 1 run in 120 under load","tags":["flaky-test","session:claude-code:4661063b-b304-434f-95f6-59a30e211068"]}}
{"metabox":"1","type":"annotation","subject":"web/e2e/echo-chrome.spec.ts","issuer":"mailto:alex@kesling.co","issuer_type":"ai","created_at":"2026-10-10T01:32:59.731541Z","id":"5cfcbebcab703a3b4870ddeea008d1500403828dff957097ffddfc90ef323a60","body":{"detail":"Passed 5 of 5 alone. Not yet diagnosed.","kind":"concern","span":{"start":{"line":440},"end":{"line":450},"content_hash":"4b2e54f93bea887975ed8ca10f6ce06c75a80510dc194e3dea17d29c3ddf1db6"},"summary":"'the artifact deleted while the viewer types in it leaves the keyboard free' took 6.2 min in one gates run","tags":["flaky-test","session:claude-code:4661063b-b304-434f-95f6-59a30e211068"]}}
