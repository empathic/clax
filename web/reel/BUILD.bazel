load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel/js:defs.bzl", "npm_script_test")
load("@rules_python//python:py_binary.bzl", "py_binary")
load(":reel.bzl", "reel_vignette")

# The sizzle reel's recorder
# (docs/superpowers/specs/2026-10-27-sizzle-reel-design.md): a package of
# its own, so nothing here is an input of //web:dist. Every target that
# records is tagged manual (reel.bzl): no `//...`, `just ci` or `just
# test-affected` builds one; `just reel` does, on demand.

# The reel's pacing, for scripts/sync-tokens.py's check that its curves are
# design/tokens.json's motion curves (//design:tokens_sync, and its own
# tests, //scripts:sync_tokens).
exports_files(
    ["pace.ts"],
    visibility = [
        "//design:__pkg__",
        "//scripts:__pkg__",
    ],
)

# The vignettes, one script each (vignettes/<id>.ts), in no particular
# order: reel.toml orders the reel.
VIGNETTES = [
    "agent",
    "claxbot",
    "coldopen",
    "dash",
    "game",
    "globe",
    "history",
    "more",
    "realtime",
    "share",
]

# A vignette script with no target here would be linted but never recorded.
[
    fail("web/reel/%s has no reel_vignette: add \"%s\" to VIGNETTES" % (f, f[len("vignettes/"):-len(".ts")]))
    for f in glob(
        ["vignettes/*.ts"],
        allow_empty = True,
    )
    if f[len("vignettes/"):-len(".ts")] not in VIGNETTES
]

# What every recording reads of this package: the recorder, the seeded
# pages and reel.toml, but no vignette, no test and not the composer
# (compose/, which :reel reads). reel_vignette adds the vignette's own
# script (:<id>_script), so an edit to one vignette re-records that one
# alone, and an edit to the composer re-records none.
copy_to_bin(
    name = "recorder",
    srcs = glob(
        ["**"],
        exclude = [
            "**/.qual",
            "compose/**",
            "**/*.test.ts",
            "**/*.spec.ts",
            "BUILD.bazel",
            "determinism.sh",
            "playwright.config.ts",
            "reel.bzl",
            "vignettes/**",
        ],
    ),
)

copy_to_bin(
    name = "tests",
    srcs = glob(["**/*.test.ts"]),
)

# The recorder's browser tests (pnpm run reel:test) and their config.
copy_to_bin(
    name = "browser_tests",
    srcs = glob(["**/*.spec.ts"]) + ["playwright.config.ts"],
)

# The cameras on the pinned Chromium (camera.spec.ts), on demand: `bazelisk
# test //web/reel:camera_test`. Outside Bazel's sandbox, as the browser
# tests run Chromium (docs/bazel.md, "Browser tests").
npm_script_test(
    name = "camera_test",
    data = [
        ":browser_tests",
        ":recorder",
        "//web:files",
        "//web:node_modules",
        "@chromium//:browsers",
    ],
    env = {"PLAYWRIGHT_BROWSERS_PATH": "$(rootpath @chromium//:browsers)"},
    # The pinned browsers stay where their repository put them.
    no_copy_to_bin = ["@chromium//:browsers"],
    project = "web",
    script = "reel:test",
    tags = [
        "manual",
        "no-sandbox",
    ],
)

# The script that records a vignette twice and compares the frames.
copy_to_bin(
    name = "determinism",
    srcs = ["determinism.sh"],
)

# Two deterministic recordings of a vignette are the same, frame for frame
# (determinism.sh), on demand and alone: `bazelisk test
# //web/reel:<id>_determinism`, as //web/reel:realtime_determinism. Each
# reads what a recording reads (reel.bzl), the binary and the browsers
# where Bazel put them.
[
    npm_script_test(
        name = v + "_determinism",
        args = [v],
        data = [
            ":determinism",
            ":%s_script" % v,
            ":recorder",
            "//crates/clax-cli:clax",
            "//crates/clax-cli:clax_warm",
            "//web:dist_e2e",
            "//web:files",
            "//web:node_modules",
            "@chromium//:browsers",
        ],
        env = {
            "CLAX_E2E_BIN": "$(rootpath //crates/clax-cli:clax)",
            "CLAX_E2E_WEB_DIST": "$(rootpath //web:dist_e2e)",
            "CLAX_GALLERY__QUICKSTART": "false",
            "PLAYWRIGHT_BROWSERS_PATH": "$(rootpath @chromium//:browsers)",
        },
        no_copy_to_bin = ["@chromium//:browsers"],
        project = "web",
        script = "reel:determinism",
        skips = ["crates/clax-cli/clax"],
        tags = [
            "cpu:4",
            "exclusive",
            "manual",
            "no-remote",
            "no-sandbox",
        ],
    )
    for v in VIGNETTES
]

[reel_vignette(name = v) for v in VIGNETTES]

# Every file, for the web project's lint, type check and unit tests
# (//web:lint, //web:typecheck, //web:unit).
filegroup(
    name = "files",
    srcs = [
        ":browser_tests",
        ":recorder",
        ":tests",
    ] + [":%s_script" % v for v in VIGNETTES],
    visibility = ["//web:__pkg__"],
)

# The vignettes the landing page's reel cuts together (compose/landing.sh
# orders them).
LANDING_CUT = [
    "agent",
    "claxbot",
    "coldopen",
    "dash",
    "game",
    "globe",
    "history",
    "realtime",
    "share",
]

# The composer's Python: the pinned CPython 3.12 with numpy and Pillow
# (compose/requirements.lock), taking compose.sh's python3 command lines.
py_binary(
    name = "reel_python",
    srcs = ["compose/python.py"],
    # No generated __init__.py files: nothing imports this package.
    legacy_create_init = 0,
    main = "compose/python.py",
    deps = [
        "@reel_pip//numpy",
        "@reel_pip//pillow",
    ],
)

# The landing page's reel, `reel.mp4` and `reel-poster.jpg`: the vignettes'
# deterministic recordings composed by compose/landing.sh with the pinned
# ffmpeg, Chromium (for the cards) and Python. On demand (manual): the
# local dev server (`just clax-dev-local`) builds it in the background, and
# the production deploy builds it and uploads it to Cloudflare Stream
# (.github/workflows/deploy-prod.yml). Outside the sandbox, as the
# recordings are, for Chromium.
genrule(
    name = "reel",
    srcs = [":%s_frames" % v for v in LANDING_CUT] + glob(
        ["compose/**"],
        exclude = ["compose/.qual"],
    ) + glob(["vignettes/*.focus.json"]) + [
        "reel.toml",
        "@chromium//:browsers",
        "@reel_ffmpeg//:ffmpeg",
        "@reel_ffmpeg//:ffprobe",
    ],
    outs = [
        "reel.mp4",
        "reel-poster.jpg",
    ],
    cmd = " ".join([
        "REEL_BROWSERS=\"$$PWD/$(execpath @chromium//:browsers)\"",
        "FFMPEG=\"$$PWD/$(execpath @reel_ffmpeg//:ffmpeg)\"",
        "FFPROBE=\"$$PWD/$(execpath @reel_ffmpeg//:ffprobe)\"",
        "REEL_PYTHON=\"$$PWD/$(execpath :reel_python)\"",
        "$(execpath compose/landing.sh) \"$$PWD/$(RULEDIR)/reel_work\"",
    ] + ["$(execpath :%s_frames)" % v for v in LANDING_CUT] + [
        "&& mv $(RULEDIR)/reel_work/reel.mp4 $(execpath reel.mp4)",
        "&& mv $(RULEDIR)/reel_work/reel-poster.jpg $(execpath reel-poster.jpg)",
        "&& rm -rf $(RULEDIR)/reel_work",
    ]),
    tags = [
        "cpu:4",
        "manual",
        "no-remote",
        "no-sandbox",
    ],
    tools = [":reel_python"],
)
