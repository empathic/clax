{
  "name": "clax-web",
  "private": true,
  "license": "AGPL-3.0-only AND GPL-2.0-only",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && node scripts/build-parts.mjs && vite build -c vite.bridge.config.ts && vite build -c vite.transport.config.ts && vite build -c vite.shell.config.ts && node scripts/build-legal.mjs && node scripts/build-extension.mjs && node scripts/build-quickstart.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "bundle-size": "node scripts/bundle-size.mjs",
    "dev": "vite -c vite.shell.config.ts",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings shell bridge extension e2e perf reel scripts vite.shell.config.ts vite.bridge.config.ts vite.bridge-parts.config.ts vite.transport.config.ts vitest.config.ts svelte.config.js playwright.config.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "e2e": "playwright test",
    "perf": "playwright test -c perf/playwright.config.ts",
    "reel:record": "node reel/record.ts",
    "reel:test": "playwright test -c reel/playwright.config.ts",
    "reel:determinism": "sh reel/determinism.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.20.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.0.0",
    "marked": "18.0.14",
    "oxlint": "^1.86.0",
    "pako": "2.1.0",
    "smol-toml": "1.9.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "modern-screenshot": "^4.6.0",
    "svelte": "^5.57.1"
  }
}
