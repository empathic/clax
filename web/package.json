{
  "name": "artifax-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build -c vite.bridge.config.ts && vite build -c vite.shell.config.ts",
    "dev": "vite -c vite.shell.config.ts",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings shell bridge e2e vite.shell.config.ts vite.bridge.config.ts vitest.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^22.20.4",
    "jsdom": "^26.0.0",
    "oxlint": "^1.86.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "modern-screenshot": "^4.6.0",
    "preact": "^10.25.0"
  }
}
