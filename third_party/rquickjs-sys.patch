 /* XXX: add a specific eval mode so that Function("}), ({") is rejected */
+/* clax: whether the source `len` bytes long that js_function_constructor
+   compiled to `fun` (a top-level function, not run) holds exactly one
+   function, spanning the whole source but its outer parentheses: what a
+   parse of the parameters and the body on their own would give. A body or
+   parameter list that closes the function and goes on fails it. */
+static bool clax_function_spans(JSValueConst fun, size_t len)
+{
+    JSFunctionBytecode *b, *inner = NULL;
+    int i;
+
+    if (JS_VALUE_GET_TAG(fun) != JS_TAG_FUNCTION_BYTECODE)
+        return false;
+    b = JS_VALUE_GET_PTR(fun);
+    for (i = 0; i < b->cpool_count; i++) {
+        if (JS_VALUE_GET_TAG(b->cpool[i]) == JS_TAG_FUNCTION_BYTECODE) {
+            if (inner)
+                return false;
+            inner = JS_VALUE_GET_PTR(b->cpool[i]);
+        }
+    }
+    return inner && len >= 2 && inner->source_len == (int)(len - 2);
+}
