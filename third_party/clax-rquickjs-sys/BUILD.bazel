# clax-rquickjs-sys (rquickjs-sys 0.14.0, patched): scripts/vendor-rquickjs.sh
# writes this file; do not edit.
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library")

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    data = glob(["quickjs/**", "src/**"]) + ["quickjs.bind.h"],
    edition = "2021",
    version = "0.14.0",
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "rquickjs_sys",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    version = "0.14.0",
    visibility = ["//visibility:public"],
    deps = [":build_script"],
)

# The manifest, for the layering check (//scripts:crate_layers) and the
# release script test.
filegroup(
    name = "manifest",
    srcs = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

exports_files(["Cargo.toml"])
