load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The brand's one token source (docs/superpowers/specs/2026-10-18-professional-ui-design.md §1),
# and the mark's: its shapes and the home app's CSS for its states (§5.11, §7.4).
filegroup(
    name = "tokens",
    srcs = [
        "mark.css",
        "mark.json",
        "tokens.json",
    ],
    visibility = ["//scripts:__pkg__"],
)

# The generated token files and the haiku copy are what design/tokens.json
# writes, app mode's colours match it, and every listed pair meets its
# contrast (scripts/sync-tokens.py --check).
sh_test(
    name = "tokens_sync",
    srcs = ["tokens-sync.sh"],
    data = [
        ":tokens",
        "//apps/clax_app:token_outputs",
        "//scripts:sync-tokens.py",
        "//web:token_inputs",
    ],
)

# The committed app icons were rendered from design/mark.json and the
# colours they use (scripts/build-app-icons.sh --check): the source hash in
# apps/clax_app/icons/SOURCE.sha256 and the generated text files, never the
# pixels, so a renderer upgrade cannot fail it.
sh_test(
    name = "icons_sync",
    srcs = ["icons-sync.sh"],
    data = [
        ":tokens",
        "//apps/clax_app:icon_outputs",
        "//scripts:build-app-icons.sh",
    ],
)
