{
  "name": "clax-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "./build.sh",
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "size": "wrangler deploy --dry-run --outdir ../../target/clax-worker/dry-run",
    "test:wasm": "node test-wasm.mjs",
    "test:bot": "node test-bot.mjs",
    "e2e": "node e2e.mjs",
    "e2e:clone": "node e2e-clone.mjs",
    "e2e:hosted": "node e2e-hosted.mjs",
    "e2e:publish": "node e2e-publish.mjs",
    "test:repos": "node test-repos.mjs"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@12.3.4"
}
