{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clax-worker",
  "main": "../../target/clax-worker/build/index.js",
  "compatibility_date": "2026-09-25",

  // build.sh builds the Worker (Bazel's //crates/clax-worker:bundle, or
  // worker-build natively) into target/clax-worker/build at the
  // repository root: the JS shim and the wasm module.
  "build": { "command": "./build.sh" },

  // The web UI (scripts/build-web.sh). Every request goes to the Worker
  // first, which serves the shell's entries and /_clax/ files from here with
  // the daemon's headers and hands everything else to the instance.
  "assets": {
    "directory": "../../web/dist",
    "binding": "WEB",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [
      { "name": "CLAX_DB", "class_name": "ClaxDb" },
      // One Clax instance per object, named by CLAX_INSTANCE.
      { "name": "CLAX_INSTANCE_DO", "class_name": "InstanceDo" },
      // Git repositories when REPO_STORE is "memory", and the repository
      // token ledger (src/repos/).
      { "name": "REPO", "class_name": "RepoDO" },
      // Each artifact's app data (the db capability's documents), one
      // object per artifact named by its ID (src/app_data.rs); only the
      // instance's object calls it.
      { "name": "APP_DATA", "class_name": "AppDataDo" }
    ]
  },
  // SQLite-backed storage: synchronous ctx.storage.sql and transactionSync.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClaxDb"] },
    { "tag": "v2", "new_sqlite_classes": ["InstanceDo"] },
    { "tag": "v3", "new_sqlite_classes": ["RepoDO"] },
    { "tag": "v4", "new_sqlite_classes": ["AppDataDo"] }
  ],

  // The Worker Loader: ClaxBot's code-mode sandbox runs each script in a
  // dynamic Worker of its own, without network or bindings (src/sandbox/).
  // `wrangler dev --local` runs them in workerd, which enforces no CPU or
  // memory limit on them.
  "worker_loaders": [{ "binding": "LOADER" }],

  // Artifact assets, in both REPO_STORE modes (src/repos/assets.rs).
  // `wrangler dev --local` simulates the bucket in its --persist-to state.
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "clax-assets" }],

  // Cloudflare Artifacts, used only when REPO_STORE is "artifacts". It has
  // no local simulator: under `wrangler dev --local` every call on the
  // binding throws.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "clax" }],

  // The Artifacts event subscription delivers `cf.artifacts.repo.*` events
  // to this queue; each `pushed` one makes the instance record the pushed
  // commits as versions (src/lib.rs, Pushes). Create the queue and the
  // subscription on the account; locally the queue is simulated and never
  // receives one, and pushes to the stand-in are recorded as they land.
  "queues": {
    "consumers": [{ "queue": "clax-artifacts-events", "max_batch_size": 10, "max_retries": 3 }]
  },

  "vars": {
    // The instance's object; empty means "default".
    "CLAX_INSTANCE": "",
    // Where artifact versions are kept: "memory", the RepoDO stand-in (git
    // repositories in its storage); deploys set "artifacts". Assets are in
    // the ASSETS bucket either way.
    "REPO_STORE": "memory",
    // "0" stops serving the stand-in over git smart HTTP at /git/*.
    "GIT_SMART_HTTP": "1",
    // The base of the URLs the server writes into results, and the origin
    // the stand-in's remotes are built on; empty means http://localhost for
    // the server and the origin each token request came to for remotes.
    // A hosted instance's public origin (required with HOSTED).
    "PUBLIC_ORIGIN": "",
    // "1" makes the instance a hosted Clax (README.md): browser sign-in
    // (/setup with the SETUP_SECRET secret, invites, sign-in links,
    // guests), each person's rights, agent tokens on /mcp.
    "HOSTED": "0",
    // A hosted instance's Terms of Service and Privacy Policy: "bundled"
    // serves docs/legal's at /terms and /privacy and asks each person to
    // agree to them; empty shows none. A deployment with its own sets
    // TERMS_URL, PRIVACY_URL and LEGAL_VERSION instead (deploy.mjs
    // --legal, --terms-url, --privacy-url, --legal-version).
    "LEGAL": "",
    // A hosted instance's site domain: each artifact's site is served at
    // <artifact ID>.<SITE_DOMAIN> (e.g. clax.run), a domain sharing no name
    // with PUBLIC_ORIGIN's host; empty serves sites at <id>.localhost.
    "SITE_DOMAIN": "",
    // The content origin of before sites (deploy.mjs carries a deploy
    // record's content_origin here): its old asset addresses redirect to
    // their artifacts' sites, and it serves nothing else. Empty: none.
    "RETIRED_CONTENT_ORIGIN": "",
    // Live seats per artifact (people, the guests' share of them, agents)
    // and a people seat's idle time in seconds; empty takes the defaults
    // (100, 20, 20, 180).
    "CLAX_LIVE_PEOPLE_SEATS": "",
    "CLAX_LIVE_GUEST_SEATS": "",
    "CLAX_LIVE_AGENT_SEATS": "",
    "CLAX_LIVE_SEAT_IDLE_S": "",
    // "1" turns on the test routes (POST /_worker/hibernate, /do/*).
    "CLAX_TEST_ROUTES": "0",
    // "1", with CLAX_TEST_ROUTES, lets ClaxBot's base_url be a loopback
    // http provider (test-bot.mjs's scripted one); otherwise the Worker sends
    // the model key to public https hosts only.
    "CLAX_TEST_LOOPBACK_PROVIDER": "0",
    // "1" serves /_dev/repos/* (test-repos.mjs passes it with --var).
    "REPO_DEV_ROUTES": "0",
    // "1" serves /_diag/* to the owner's token (CLAX_TOKEN must be set):
    // what the platform's bindings answer, for smoke-remote.mjs (src/diag.rs).
    "CLAX_DIAG_ROUTES": "0",
    // The build identity /healthz reports as `build`; deploy.mjs sets one
    // unique to each upload and waits until /healthz names it. Empty is null.
    "CLAX_BUILD": ""
  }
  // CLAX_TOKEN, the owner's bearer token, is a secret: `wrangler secret put
  // CLAX_TOKEN` for a deploy, `.dev.vars` or `--var CLAX_TOKEN:<value>` for
  // `wrangler dev`; at least 32 characters. Unset, the instance makes one and
  // keeps it in its storage.
  // SETUP_SECRET, which a hosted instance's /setup takes once, is a secret
  // the same way; unset, setup stays closed.
  // CLAX_KEK, 64 hex digits, seals the model keys ClaxBot stores (src/bot.rs);
  // a secret the same way, made once by deploy.mjs and never rotated. Unset
  // or malformed, no key is stored and ClaxBot answers not_configured.
  // CLAX_FEEDBACK_QUEUE (a queue ID) and CLAX_FEEDBACK_SERVICE_GRANT (JSON
  // {token, private_key_pkcs8} of that queue's service grant) turn on a
  // hosted instance's own feedback integration (src/instance.rs
  // feedback_of, docs/prod.md); each is read as a secret, else a --var of
  // the name, and with either unset the integration is off. Neither is a
  // var here: a deploy rewrites the vars from this file, and a secret may
  // not share a var's name.
}
