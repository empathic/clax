load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:cargo.bzl", "cargo_package")

cargo_package(
    # The web UI the Worker embeds (src/web.rs): the build script names it,
    # and rust-embed reads its files at compile time.
    build_script_data = ["//web:dist"],
    build_script_env = {"CLAX_WEB_DIST_DIR": "$(execpath //web:dist)"},
    # The Worker's wasm module (bazel/wasm/worker.bzl).
    cdylib = True,
    compile_data = ["//web:dist"],
    # rust-embed reads the web UI by the absolute path the build script
    # names, which differs in each action's sandbox, so the metadata and
    # the rlib are made in one action (crates/clax-embedded's BUILD.bazel).
    disable_pipelining = True,
    # src/repos/tests drive the daemon in process.
    lib_test_uses_testkit = True,
    # The older builds' migrations tests/store_on_vfs.rs includes.
    test_compile_data = ["//crates/clax-store:old_migrations"],
)

# What deploy.mjs decides from what it reads (deploy-lib.mjs):
# node --test crates/clax-worker/deploy-lib.test.mjs, as a Bazel test.
copy_to_bin(
    name = "deploy_lib",
    srcs = ["deploy-lib.mjs"],
)

js_test(
    name = "deploy_lib_test",
    data = [":deploy_lib"],
    entry_point = "deploy-lib.test.mjs",
    node_options = ["--test"],
    patch_node_fs = False,
)
