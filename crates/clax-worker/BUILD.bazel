load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@npm_worker//:defs.bzl", "npm_link_all_packages")
load("//bazel:cargo.bzl", "cargo_package")
load("//bazel/wasm:worker.bzl", "worker_bundle")

# The web UI the Worker embeds (src/web.rs); on wasm32 the host's build of
# it (bazel/wasm/host_files.bzl).
alias(
    name = "web_dist",
    actual = select({
        "//bazel/wasm:is_wasm32": "//bazel/wasm:web_dist",
        "//conditions:default": "//web:dist",
    }),
)

cargo_package(
    # The build script names the web UI, and rust-embed reads its files at
    # compile time.
    build_script_data = [":web_dist"],
    build_script_env = {"CLAX_WEB_DIST_DIR": "$(execpath :web_dist)"},
    # The Worker's wasm module (bazel/wasm/worker.bzl).
    cdylib = True,
    compile_data = [":web_dist"],
    # rust-embed reads the web UI by the absolute path the build script
    # names, which differs in each action's sandbox, so the metadata and
    # the rlib are made in one action (crates/clax-embedded's BUILD.bazel).
    disable_pipelining = True,
    # src/repos/tests drive the daemon in process.
    lib_test_uses_testkit = True,
    # The older builds' migrations tests/store_on_vfs.rs includes.
    test_compile_data = ["//crates/clax-store:old_migrations"],
)

# The Worker as wrangler deploys it: the wasm module built for wasm32 with
# the worker-release profile, through worker-build's steps
# (bazel/wasm/worker.bzl). build.sh links target/clax-worker/build to it.
worker_bundle(
    name = "bundle",
    description = "A Cloudflare Worker that runs the Clax server in a Durable Object per instance, its database in the object's own storage",
    license = "AGPL-3.0-only",
    package_name = "clax-worker",
    sdk_version = "0.8.7",
    version = "0.0.0",
    wasm = ":clax_worker_wasm_shared",
)

# What deploy.mjs decides from what it reads (deploy-lib.mjs):
# node --test crates/clax-worker/deploy-lib.test.mjs, as a Bazel test.
js_test(
    name = "deploy_lib_test",
    data = [":scripts"],
    entry_point = "deploy-lib.test.mjs",
    node_options = ["--test"],
    patch_node_fs = False,
)

# wrangler, from pnpm-lock.yaml.
npm_link_all_packages(name = "node_modules")

# What the checks run under `wrangler dev --local` read: the scripts, the
# harness and wrangler.jsonc, beside the Worker as Bazel built it
# (CLAX_WORKER_BUNDLE) and the web UI it serves (web/dist, which
# harness.mjs finds from here).
copy_to_bin(
    name = "scripts",
    srcs = glob(
        ["*.mjs"],
        # The tests' entry points, which js_test places itself.
        exclude = [
            "deploy-lib.test.mjs",
            "e2e.mjs",
            "e2e-github.mjs",
            "e2e-hosted.mjs",
            "test-bot.mjs",
            "test-deploy-config.mjs",
            "test-sandbox.mjs",
            "test-wasm.mjs",
        ],
    ) + ["wrangler.jsonc"],
)

# Each under `wrangler dev --local` on the Worker Bazel built: the wasm
# Worker's database across a restart (test-wasm.mjs), ClaxBot's sandbox
# conformance suite on the Worker Loader sandbox (test-sandbox.mjs), and a
# ClaxBot run driven by the instance's alarm, across a restart
# (test-bot.mjs).
[js_test(
    name = name + "_test",
    args = ["--no-build"],
    data = [
        ":bundle",
        ":node_modules",
        ":scripts",
        "//web:dist",
    ],
    entry_point = "test-%s.mjs" % name,
    env = {"CLAX_WORKER_BUNDLE": "$(rootpath :bundle)"},
    patch_node_fs = False,
    # Each starts wrangler and workerd, more than once across a restart.
    tags = ["cpu:2"],
    timeout = "long",
) for name in [
    "wasm",
    "sandbox",
    "bot",
]]

# The Clax server in its Durable Object under `wrangler dev --local`, in
# two browsers (e2e.mjs), and as a hosted Clax with each artifact's site on
# its own host (e2e-hosted.mjs): Playwright from the web UI's packages,
# found through web/package.json, and the pinned Chromium. GitHub sign-in
# against a fake GitHub (e2e-github.mjs) runs on demand only
# (`bazelisk test //crates/clax-worker:e2e_github`).
[js_test(
    name = name,
    args = ["--no-build"],
    data = [
        ":bundle",
        ":node_modules",
        ":scripts",
        "//web:dist",
        "//web:files_app",
        "//web:node_modules/@playwright/test",
        "@chromium//:browsers",
    ],
    entry_point = entry,
    env = {
        "CLAX_WORKER_BUNDLE": "$(rootpath :bundle)",
        "PLAYWRIGHT_BROWSERS_PATH": "$(rootpath @chromium//:browsers)",
    },
    # The pinned browsers stay where their repository put them.
    no_copy_to_bin = ["@chromium//:browsers"],
    patch_node_fs = False,
    # Chromium runs outside Bazel's sandbox, as the web UI's browser tests
    # do (docs/bazel.md, "Browser tests").
    tags = [
        "cpu:4",
        "no-sandbox",
    ] + (["manual"] if name == "e2e_github" else []),
    timeout = "long",
) for name, entry in [
    ("e2e", "e2e.mjs"),
    ("e2e_hosted", "e2e-hosted.mjs"),
    ("e2e_github", "e2e-github.mjs"),
]]

# The config deploy.mjs generates, without wrangler.
js_test(
    name = "deploy_config_test",
    data = [":scripts"],
    entry_point = "test-deploy-config.mjs",
    patch_node_fs = False,
)

