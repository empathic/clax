load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("//bazel:cargo.bzl", "cargo_package")

cargo_package(
    # clax-core's tool path test vectors, which the audit export's tests
    # read (src/toolpath/tests.rs, redact.rs, and seal.rs by #[path]), and
    # the older builds' migrations the repair's tests include
    # (src/migrations.rs).
    test_compile_data = glob(["tests/fixtures/**"]) + ["//crates/clax-core:toolpath_vectors"],
    test_data = ["//crates/clax-core:toolpath_vectors"],
    # The rerun of the store's tests on one connection is the target below.
    test_env = {"CLAX_TEST_STORE_ONE_CONNECTION": "apart"},
)

# The store's tests again, on one connection
# (tests::the_store_tests_pass_on_one_connection, alone): a target of its
# own, so the two runs of the suite go side by side, each within a test
# target's time, rather than one after the other in clax_store_lib_test.
native_test(
    name = "clax_store_one_connection_test",
    src = ":clax_store_lib_test",
    out = "clax_store_one_connection_test",
    args = [
        "--exact",
        "tests::the_store_tests_pass_on_one_connection",
    ],
)

# The older builds' migrations (tests/fixtures/old-migrations), which the
# server's and the Worker's repair tests include too.
filegroup(
    name = "old_migrations",
    srcs = glob(["tests/fixtures/old-migrations/*.sql"]),
    visibility = ["//crates/clax-server:__pkg__"],
)

# may_move's table (tests/fixtures/job-moves.json), which src/job_moves_fixture.rs
# and the app's queue tests (apps/clax_app/test/queue/job_moves_test.dart)
# check alike.
filegroup(
    name = "job_moves_fixture",
    srcs = ["tests/fixtures/job-moves.json"],
    visibility = ["//apps/clax_app:__pkg__"],
)
