load("//bazel:cargo.bzl", "cargo_package")

cargo_package(
    # clax-core's tool path test vectors, which the audit export's tests
    # read (src/toolpath/tests.rs, redact.rs, and seal.rs by #[path]), and
    # the older builds' migrations the repair's tests include
    # (src/migrations.rs).
    test_compile_data = glob(["tests/fixtures/**"]) + ["//crates/clax-core:toolpath_vectors"],
    test_data = ["//crates/clax-core:toolpath_vectors"],
    # The unit tests run as six targets of about equal length:
    # clax_store_lib_test (every module no group names) and
    # clax_store_lib_test__2 … __6. They run again on one connection as
    # clax_store_one_connection_test__1 … __6: the rerun
    # tests::the_store_tests_pass_on_one_connection makes under Cargo,
    # which CLAX_TEST_STORE_ONE_CONNECTION=apart leaves out here.
    split_lib_test = {
        "groups": [
            # The migrations' tests, the longest, in two.
            [
                "migrations::tests::every_",
                "migrations::tests::repair::",
            ],
            ["migrations::"],
            [
                "app_data::",
                "feedback::",
                "sessions::",
            ],
            [
                "approvals::",
                "artifacts::",
                "backfill::",
                "inbox::",
                "jobs::",
                "queues::",
            ],
            [
                "credits::",
                "engagement::",
                "exec::",
                "forks::",
                "joined::",
                "site::",
                "threads::",
                "toolpath::",
                "viewers::",
                "visibility::",
            ],
        ],
        "reruns": {"one_connection": {
            # The pool's own tests open the pool in either mode.
            "args": [
                "--skip",
                "exec::tests::",
            ],
            "env": {"CLAX_TEST_STORE": "single"},
        }},
    },
    test_env = {"CLAX_TEST_STORE_ONE_CONNECTION": "apart"},
)

# The older builds' migrations (tests/fixtures/old-migrations), which the
# server's and the Worker's repair tests include too.
filegroup(
    name = "old_migrations",
    srcs = glob(["tests/fixtures/old-migrations/*.sql"]),
    visibility = [
        "//crates/clax-server:__pkg__",
        "//crates/clax-worker:__pkg__",
    ],
)

# may_move's table (tests/fixtures/job-moves.json), which src/job_moves_fixture.rs
# and the app's queue tests (apps/clax_app/test/queue/job_moves_test.dart)
# check alike.
filegroup(
    name = "job_moves_fixture",
    srcs = ["tests/fixtures/job-moves.json"],
    visibility = ["//apps/clax_app:__pkg__"],
)
