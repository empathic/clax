load("//bazel/android:clax.bzl", "android_clax")
load("//bazel:cargo.bzl", "cargo_package")
load("//bazel:opt.bzl", "opt_binary")
load("//bazel:warm.bzl", "warm_binary")

cargo_package(
    # The modules of tests/integration.rs in three test targets (bazel/cargo.bzl).
    split_tests = {"integration": {"groups": 3}},
    # The launcher tests/cli.rs checks the release pins.
    test_compile_data = ["//scripts:ensure-clax.sh"],
    test_data = [
        "//:marketplaces",
        "//plugins:embedded",
        "//plugins/pi:embedded",
        "//plugins/pi:test_fixtures",
        "//scripts:all",
        "//web:dist",
        "//web:dist_extension",
    ],
    tests_use_clax = [
        "clax_bin_test",
        "descriptors",
        "integration",
    ],
)

# The binary, run once before any test runs it (bazel/warm.bzl).
warm_binary(
    name = "clax_warm",
    binary = ":clax",
    visibility = ["//visibility:public"],
)

# The optimized binary (bazel/opt.bzl), run once too: the perf benchmarks
# run it, and `scripts/bazel-test.sh --ci` builds it as the native checks
# build the release binary.
opt_binary(
    name = "clax_opt",
    binary = ":clax",
    visibility = ["//visibility:public"],
)

warm_binary(
    name = "clax_opt_warm",
    binary = ":clax_opt",
    visibility = ["//visibility:public"],
)

# The Clax app's embedded clax, for each Android CPU it ships
# (bazel/android/clax.bzl).
android_clax(
    name = "clax_android_arm64",
    abi = "arm64-v8a",
    binary = ":clax",
    platform = "//bazel/android:android_arm64",
    visibility = ["//visibility:public"],
)

android_clax(
    name = "clax_android_x86_64",
    abi = "x86_64",
    binary = ":clax",
    platform = "//bazel/android:android_x86_64",
    visibility = ["//visibility:public"],
)
