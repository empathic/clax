load("//bazel:cargo.bzl", "cargo_package")
load("//bazel:opt.bzl", "opt_binary")
load("//bazel:warm.bzl", "warm_binary")

cargo_package(
    # The modules of tests/integration.rs in three test targets (bazel/cargo.bzl).
    split_tests = {"integration": {"groups": 3}},
    # The plugins' skills `clax doctor --agent` compares
    # (src/commands/doctor_agent.rs).
    compile_data = [
        "//plugins:embedded",
        "//plugins/pi:embedded",
    ],
    test_compile_data = [
        "//scripts:ensure-clax.sh",
        "//web:shell_cases",
    ],
    test_data = [
        "//:marketplaces",
        "//plugins:embedded",
        "//plugins/pi:embedded",
        "//plugins/pi:test_fixtures",
        "//scripts:all",
        "//web:dist",
        "//web:dist_extension",
    ],
    tests_use_clax = [
        "clax_bin_test",
        "descriptors",
        "integration",
    ],
)

# The binary, run once before any test runs it (bazel/warm.bzl).
warm_binary(
    name = "clax_warm",
    binary = ":clax",
    visibility = ["//visibility:public"],
)
# Its lints, which scripts/bazel-test.sh hands to clippy for this crate's
# targets, as Cargo reads it from beside Cargo.toml.
exports_files(["clippy.toml"])

# The optimized binary (bazel/opt.bzl), run once too: the perf benchmarks
# run it, and `scripts/bazel-test.sh --ci` builds it as the native checks
# build the release binary.
opt_binary(
    name = "clax_opt",
    binary = ":clax",
    visibility = ["//visibility:public"],
)

warm_binary(
    name = "clax_opt_warm",
    binary = ":clax_opt",
    visibility = ["//visibility:public"],
)
