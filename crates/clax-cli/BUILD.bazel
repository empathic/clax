load("//bazel:cargo.bzl", "cargo_package")
load("//bazel:opt.bzl", "opt_binary")
load("//bazel:warm.bzl", "warm_binary")

EMBEDDED = [
    "//:marketplaces",
    "//plugins:embedded",
    "//plugins/pi:embedded",
]

cargo_package(
    # The modules of tests/integration.rs in three test targets (bazel/cargo.bzl).
    split_tests = {"integration": {"groups": 3, "not": []}},
    build_script_data = EMBEDDED + ["//web:dist_extension"],
    # The extension build and the plugin trees the binary embeds
    # (src/extension_files.rs, src/plugins.rs): Bazel's copies.
    build_script_env = {
        "CLAX_EXTENSION_DIST_DIR": "$(execpath //web:dist_extension)",
        "CLAX_PLUGINS_DIR": "$${pwd}/$(BINDIR)/plugins",
    },
    # The plugin trees and other files the sources include, beside them in
    # bazel-bin, where rules_rust places sources that compile with
    # generated files.
    compile_data = [
        "//:marketplaces_bin",
        "//plugins:embedded_bin",
        "//plugins/pi:embedded_bin",
        "//scripts:ensure_clax_bin",
        "//web:dist_extension",
        "//web:shell_cases_bin",
    ],
    test_compile_data = ["//scripts:ensure-clax.sh"],
    test_data = [
        "//:marketplaces",
        "//plugins:embedded",
        "//plugins/pi:embedded",
        "//plugins/pi:test_fixtures",
        "//scripts:all",
        "//web:dist_extension",
    ],
    tests_use_clax = [
        "clax_bin_test",
        "descriptors",
        "integration",
    ],
)

# The binary, run once before any test runs it (bazel/warm.bzl).
warm_binary(
    name = "clax_warm",
    binary = ":clax",
    visibility = ["//visibility:public"],
)
# Its lints, which scripts/bazel-test.sh hands to clippy for this crate's
# targets, as Cargo reads it from beside Cargo.toml.
exports_files(["clippy.toml"])

# The optimized binary (bazel/opt.bzl), run once too: the perf benchmarks
# run it, and `scripts/bazel-test.sh --ci` builds it as the native checks
# build the release binary.
opt_binary(
    name = "clax_opt",
    binary = ":clax",
    visibility = ["//visibility:public"],
)

warm_binary(
    name = "clax_opt_warm",
    binary = ":clax_opt",
    visibility = ["//visibility:public"],
)
