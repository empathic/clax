load("//bazel:cargo.bzl", "cargo_package")

cargo_package(
    # The modules of tests/integration.rs in six test targets (bazel/cargo.bzl).
    split_tests = {"integration": {"groups": 6}},
    # As crates/clax-server/Cargo.toml has it: no QuickJS on Android or iOS.
    deps_not_on = {"//crates/clax-bot-js:clax_bot_js": [
        "@platforms//os:android",
        "@platforms//os:ios",
    ]},
    # The runtime contract's type definitions src/shell/mod.rs serves.
    compile_data = ["//web:contract_files"],
    # clax-http's sources the route-table guards read (src/routes/guards.rs),
    # the JSON fixtures the tests include (tests/api_mcp_http.rs), and the
    # older builds' migrations tests/api_threads.rs includes.
    test_compile_data = glob(["tests/fixtures/**"]) + [
        "//crates/clax-core:toolpath_vectors",
        "//crates/clax-http:rust_sources",
        "//crates/clax-store:old_migrations",
        "//web:contract_files",
        "//web:shell_cases",
    ],
    test_data = [
        "//:marketplaces",
        "//crates/clax-testkit:fixtures",
        "//docs:contract",
        "//plugins:embedded",
        "//plugins/pi:embedded",
        "//plugins/pi:files",
        "//plugins/pi:node_modules",
        "//plugins/pi:test_fixtures",
        "//scripts:hook_scripts",
        "//web:contract_files",
        "//web:dist",
        "@nodejs//:node_bin",
    ],
    test_env = {"CLAX_TEST_NODE": "$(rootpath @nodejs//:node_bin)"},
    tests_use_clax = [
        "clax_server_lib_test",
        "integration",
    ],
)

# The router's source, which the testkit's people fixture reads
# (crates/clax-testkit/src/people.rs).
filegroup(
    name = "router_source",
    srcs = ["src/router.rs"],
    visibility = ["//crates/clax-testkit:__pkg__"],
)
