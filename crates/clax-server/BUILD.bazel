load("//bazel:cargo.bzl", "cargo_package")

cargo_package(
    # The modules of tests/integration.rs in six test targets (bazel/cargo.bzl);
    # these three are tests/web_dist.rs's.
    split_tests = {"integration": {"groups": 6, "not": ["bridge_dev", "shell_boot", "shell_entries"]}},
    build_script_data = ["//web:dist"],
    # The web UI the library embeds (src/routes/shell.rs).
    build_script_env = {"CLAX_WEB_DIST_DIR": "$(execpath //web:dist)"},
    compile_data = [
        "//web:contract_bin",
        "//web:dist",
        "//web:shell_cases_bin",
    ],
    test_compile_data = [
        "//crates/clax-core:toolpath_vectors",
        "//web:contract_files",
        "//web:shell_cases",
    ],
    test_data = [
        "//:marketplaces",
        "//docs:contract",
        "//plugins:embedded",
        "//plugins/pi:embedded",
        "//plugins/pi:files",
        "//plugins/pi:node_modules",
        "//plugins/pi:test_fixtures",
        "//scripts:hook_scripts",
        "//web:contract_files",
        "//web:dist",
        "@nodejs//:node_bin",
    ],
    test_env = {"CLAX_TEST_NODE": "$(rootpath @nodejs//:node_bin)"},
    tests_use_clax = [
        "clax_server_lib_test",
        "integration",
        "web_dist",
    ],
)

# The people fixture clax-cli's tests share (crates/clax-cli/tests/common),
# and the routes' source it reads.
filegroup(
    name = "test_people",
    srcs = [
        "src/routes/mod.rs",
        "tests/common/people.rs",
    ],
    visibility = ["//crates/clax-cli:__pkg__"],
)

# The sources clax-core's tests read (crates/clax-core/src/feedback.rs).
filegroup(
    name = "srcs",
    srcs = glob(["src/**"], exclude = ["**/.qual"]),
    visibility = ["//crates:__subpackages__"],
)
