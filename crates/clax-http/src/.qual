{"metabox":"1","type":"annotation","subject":"crates/clax-http/src/identity.rs","issuer":"mailto:alex@kesling.co","issuer_type":"ai","created_at":"2026-10-31T03:31:22.737380Z","id":"cd7406f8e959d113be7b11d3ae136b13a393dcc95ab4b9d0cbbe46ba4e1be980","body":{"kind":"comment","references":"f090ac7c1a7c975ec9e1418507cb2b67597de9504865b7b24ab73dbadf514033","summary":"Commit 645e573f2 cited by this close was re-signed as 924660b45 (same tree, author and message).","tags":["session:claude-code:988152cb-8f78-4b12-acdd-a455490bed05"]}}
