load("//bazel:cargo.bzl", "cargo_package")

cargo_package(
    tests_use_clax = [
        "clax_hooks_lib_test",
        "golden",
    ],
)

# The hook fixtures the comment loop gate feeds clax (//scripts:comment_loop).
filegroup(
    name = "fixtures",
    srcs = glob(["tests/fixtures/**"]),
    visibility = ["//scripts:__pkg__"],
)
