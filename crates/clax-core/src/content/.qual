{"metabox":"1","type":"annotation","subject":"crates/clax-core/src/content/mod.rs","issuer":"mailto:alex@kesling.co","issuer_type":"ai","created_at":"2026-10-14T12:31:11.908718Z","id":"48b5ca8743c2a252da48faea4a498d56ca53ec37e487038ab755e24d566ce320","body":{"kind":"resolve","summary":"Duplicate head left by a merge: this is a parallel branch's re-anchor of the record that a2497a85dc479579b13269d079537b376dfd789fd804c90a3031666cf27ec028 closed (Fixed: the contract says what version n follows. content/mod.rs Versions: n follows the newest present version below it (none for a first version, which may be ). That close stands in the merged code; this head carries no new content.","supersedes":"3d3ec931d14cf3cbd33c6c0f2fb5e0a03d6c918fd2a420c1e0d8dc633ca3b49d","tags":["reason:duplicate","session:claude-code:6847a238-376f-486d-8e40-4d0fa676e347"]}}
