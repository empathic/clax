{"metabox":"1","type":"annotation","subject":"crates/clax-core/src/store/migrations.rs","issuer":"mailto:alex@kesling.co","issuer_type":"ai","created_at":"2026-10-17T06:42:34.264950Z","id":"5599c994ee1ab574d58ea7fa3a6378549718fc50d1fa413c7bb1e1ec4c0184a8","body":{"kind":"resolve","ref":"git:9f99ad872417faa2c56a8038f471dc5e83cf3124","summary":"Moved to crates/clax-store/src/migrations.rs:724:727 as 0ddfa157 in git:9f99ad87","supersedes":"5367fcc4689814242a680d9584e3d3bf9fc8dbd0f19447b827af1efaa70fb5d1","tags":["reason:obsolete","session:claude-code:4661063b-b304-434f-95f6-59a30e211068"]}}
