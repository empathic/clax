{"metabox":"1","type":"annotation","subject":"crates/clax-core/src/lib.rs","issuer":"mailto:alex@kesling.co","issuer_type":"ai","created_at":"2026-10-19T19:59:20.441368Z","id":"98bbabe5483580bfaf95132633b0b9f545432f9680ceb425b01d9b35827dae78","body":{"kind":"resolve","ref":"git:14cf0d25d","summary":"Fixed (doc-only): the crate doc names perf::Calibration as the one place that queries SQLite.","supersedes":"ff4a0a8b1624e4aad58074f22f34e816b28780023702b3f8a30ce51d16f6cb3b","tags":["reason:fixed","session:claude-code:39187025-0a9f-4b13-8d2e-a1ea08e924ac"]}}
