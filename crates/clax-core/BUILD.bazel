load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:cargo.bzl", "cargo_package")

cargo_package(
    build_script_data = ["//web:extension_key"],
    compile_data = ["//web:extension/manifest.json"] + glob(["tests/toolpath/**"]),
    test_data = [
        # The sources the delivery guard scans (src/feedback.rs).
        ":rust_sources",
        "//crates/clax-http:rust_sources",
        "//crates/clax-realtime:rust_sources",
        "//crates/clax-server:rust_sources",
        "//plugins/pi:test_fixtures",
    ],
)

# The tool path test vectors other crates' tests read.
filegroup(
    name = "toolpath_vectors",
    srcs = glob(["tests/toolpath/**"]),
    visibility = ["//visibility:public"],
)

# The same, in bazel-bin, for the web UI's and Pi's tests (rules_js reads
# its inputs there).
copy_to_bin(
    name = "toolpath_vectors_bin",
    srcs = [":toolpath_vectors"],
    visibility = ["//visibility:public"],
)
