load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:cargo.bzl", "cargo_package")

cargo_package(
    build_script_data = ["//web:extension_key"],
    compile_data = ["//web:extension/manifest.json"],
    # The vectors clax-core's own tests include (src/audit/args.rs,
    # src/gitctx_capture_tests.rs); the rest are clax-store's, so an edit to
    # them recompiles no library.
    test_compile_data = [
        "tests/toolpath/args-hash-vectors.json",
        "tests/toolpath/git-capture-vectors.json",
        # The scrubbing cases the SDK's tests run too (src/scrub.rs).
        "//web:sdk_scrub_cases",
    ],
    test_data = [
        # The sources the delivery guard scans (src/feedback.rs).
        ":rust_sources",
        "//crates/clax-http:rust_sources",
        "//crates/clax-realtime:rust_sources",
        "//crates/clax-server:rust_sources",
        "//crates/clax-store:rust_sources",
        "//plugins/pi:test_fixtures",
        # The icon rule vectors (src/icon.rs).
        ":icon_fixtures",
    ],
)

# The icon rule vectors, each file's answer in expect.json: src/icon.rs's
# tests and the app's (apps/clax_app/test/agent/icon_fixtures_test.dart)
# run them alike.
filegroup(
    name = "icon_fixtures",
    srcs = glob(["tests/fixtures/icons/**"]),
    visibility = ["//visibility:public"],
)

# The tool path test vectors other crates' tests read.
filegroup(
    name = "toolpath_vectors",
    srcs = glob(["tests/toolpath/**"]),
    visibility = ["//visibility:public"],
)

# The same, in bazel-bin, for the web UI's and Pi's tests (rules_js reads
# its inputs there).
copy_to_bin(
    name = "toolpath_vectors_bin",
    srcs = [":toolpath_vectors"],
    visibility = ["//visibility:public"],
)
