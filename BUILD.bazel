load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

# Marks the workspace root as a package, so MODULE.bazel can name Cargo.toml
# and Cargo.lock. The crates have their own BUILD files (docs/bazel.md).
exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "clippy.toml",
    "rust-toolchain.toml",
    "install.sh",
    ".bazelversion",
    "README.md",
    ".claude-plugin/marketplace.json",
])

# The workspace version, which the extension's manifest takes
# (web/scripts/extension-manifest.mjs reads ../Cargo.toml).
copy_to_bin(
    name = "cargo_toml",
    srcs = ["Cargo.toml"],
    visibility = ["//web:__pkg__"],
)

# The plugin marketplaces clax embeds (crates/clax-cli/src/plugins.rs).
filegroup(
    name = "marketplaces",
    srcs = [
        ".agents/plugins/marketplace.json",
        ".claude-plugin/marketplace.json",
        ".grok-plugin/marketplace.json",
    ],
    visibility = ["//visibility:public"],
)

# A crate whose compile inputs include a generated directory has its sources
# placed in bazel-bin by rules_rust, so its include_str!s of files outside
# the crate resolve there: these are those files, copied beside it.
copy_to_bin(
    name = "marketplaces_bin",
    srcs = [":marketplaces"],
    visibility = ["//visibility:public"],
)
