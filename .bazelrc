# Shared settings. Machine-specific ones go in user.bazelrc (git-ignored; see
# user.bazelrc.example), or in ~/.bazelrc to cover every worktree at once.

common --enable_platform_specific_config

# A worktree's server leaves after 15 idle minutes (the default is 3 hours)
# and may not grow past 3 GB: there is one per worktree.
startup --max_idle_secs=900
startup --host_jvm_args=-Xmx3g

# rules_js reports which rule sets and versions a build uses to its authors
# unless told not to.
common --repo_env=DO_NOT_TRACK=1

# rules_flutter's Java tools (rules_jvm_external, rules_android) are compiled
# for Java 21 and later; Bazel's own tool JDK is older.
common --tool_java_language_version=25
common --tool_java_runtime_version=remotejdk_25
# The app's own Java and Kotlin compile for Java 17, as its Gradle build
# does, with a JDK rules_java fetches by checksum (never a local one).
common --java_language_version=17
common --java_runtime_version=remotejdk_21

# An APK's native libraries, which reach it as Java resources
# (bazel/flutter/android.bzl), compressed as Gradle packs them for an app
# that extracts them (android:extractNativeLibs="true").
build --experimental_android_compress_java_resources

# rules_apple's iOS CPU: the simulator on Apple silicon. A device build
# passes --ios_multi_cpus=arm64.
build --ios_multi_cpus=sim_arm64
# The oldest iOS the Clax app runs on. Every iOS configuration, the app's
# and //crates/clax-embed:clax_embed_ios_builds' alike, compiles for it, the
# C of ring and the bundled SQLite included (bazel/apple/ios_rust.bzl passes
# it to rustc); //crates/clax-embed:ios_build_test fails on an object built
# for a newer iOS.
build --ios_minimum_os=17.0
# An imported framework's module map is an input of Objective-C compiles,
# so a plugin's `@import Flutter;` (image_picker_ios) finds the engine's
# module in the sandbox. rules_apple keeps it out unless told.
build --define=apple.incompatible.objc_framework_propagate_modulemap=true

# Actions see a fixed environment, so their results can be shared.
build --incompatible_strict_action_env

# The compile cache, shared with ../changelist and every other project on
# this machine: one directory, one bound. ../changelist/.bazelrc states the
# same three lines; change both together (docs/bazel.md, "Disk").
build --disk_cache=~/.cache/bazel-disk
build --experimental_disk_cache_gc_max_size=100G
build --experimental_disk_cache_gc_max_age=7d

# The whole machine: Bazel runs as many actions as there are cores (its
# default). To hold a build back on a shared machine, set limits in
# user.bazelrc (user.bazelrc.example). scripts/bazel-sync.sh --check fails
# if a limit on jobs or cores is committed here.
build --@rules_rust//rust/settings:extra_rustc_flag=-Ccodegen-units=16
build --@rules_rust//rust/settings:extra_exec_rustc_flag=-Ccodegen-units=16
build --@rules_rust//rust/settings:pipelined_compilation=True
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
test --test_env=RUST_TEST_THREADS=4
test --test_env=TOKIO_WORKER_THREADS=4
# As .cargo/config.toml gives Cargo's tests: CLAX_PORT empty, so a port in
# the developer's shell never moves a test daemon.
test --test_env=CLAX_PORT=
# The system's tools a test runs (lsof is in /usr/sbin on macOS), and
# nothing of the developer's own PATH.
test --test_env=PATH=/usr/bin:/bin:/usr/sbin:/sbin

test --test_output=errors

# The options `dart analyze` checks the Clax app's Dart against
# (//apps/clax_app:dart_analyze, a dart_analysis_test).
common --@rules_dart//dart:analysis_config=//apps/clax_app:analysis_config

# --config=clippy: lint instead of only compiling, as `cargo clippy
# --all-targets -- -D warnings` does. A lint is a build failure.
build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=+clippy_checks
build:clippy --@rules_rust//rust/settings:clippy_flag=-Dwarnings

# --config=fmt: check formatting, as `cargo fmt --all -- --check` does.
build:fmt --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build:fmt --output_groups=+rustfmt_checks

# --config=ci: the whole runner. CI applies it to every command
# (`common --config=ci` in user.bazelrc, .github/actions/setup-bazel). Its
# downloads and its disk cache are restored and saved by actions/cache, so
# the cache is held to what fits one.
common:ci --repository_cache=~/.cache/bazel-repo
common:ci --lockfile_mode=error
build:ci --experimental_disk_cache_gc_max_size=6G
# Five minutes a test target, where a loaded developer machine gets
# fifteen (bazel/cargo.bzl): a test that hangs must not use up the job.
test:ci --test_timeout=300

try-import %workspace%/user.bazelrc
