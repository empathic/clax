{"metabox":"1","type":"annotation","subject":"scripts/lib/feedback-config.py","issuer":"mailto:alex@kesling.co","issuer_type":"ai","created_at":"2026-10-29T17:44:36.357187Z","id":"e9c6a9d28c8dd3f5f74eb70702534a5027842b94bcde954604d71de7bd80da3f","body":{"detail":"write writes <config>.tmp.<pid> and os.replace()s it over the config; an error between open and replace (disk full, chmod failing) leaves the temp file. It holds no secret (the grant is in its own file), only the config text.","kind":"concern","span":{"start":{"line":115},"end":{"line":124},"content_hash":"c2c3b65b970d29ea2776aef3c9d35580a1489274f2b44cbd2d222a982f11ed18"},"suggested_fix":"Wrap the write in try/finally that removes the temp file unless it was replaced.","summary":"feedback-config.py leaves its temp file behind when a write fails","tags":["feedback","scripts","session:claude-code:985c579c-9fcb-4f5b-b70f-deedb4f3ea58"]}}
