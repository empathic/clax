# The process launches left in the crates the iOS daemon links, each kept off
# on iOS (scripts/check-ios-spawns.sh; docs/usage.md, "Clax on iPhone and
# iPad"). `<path> <fn>  # how`, or `skip <path>  # why`.
crates/clax-core/src/gitctx.rs spawn  # reached only through capture, which answers unavailable on iOS, and find_git finds no git there
crates/clax-core/src/remote.rs process_started  # the ps arm's cfg excludes iOS
crates/clax-mcp/src/channel.rs process_argv  # the ps arm's cfg excludes iOS
crates/clax-mcp/src/tools.rs run_opener  # reached only through open_in_browser, which answers false on iOS
crates/clax-realtime/src/push.rs run_queue  # CodexPush, which the iOS host builds disabled
skip crates/clax-mcp/src/shim.rs  # the stdio shim, for local agents
skip crates/clax-mcp/src/probe.rs  # the shim's probe
skip crates/clax-mcp/src/standdown.rs  # the shim's stand-down server
