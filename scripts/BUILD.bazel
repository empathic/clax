load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:release_files.bzl", "RELEASE_FILES")

# The plugin wrapper clax embeds (crates/clax-embedded/src/lib.rs).
exports_files(
    ["ensure-clax.sh"],
    visibility = ["//crates:__subpackages__"],
)

# The Clax app's prompt copies' check (//apps/clax_app:prompt_sync).
exports_files(
    ["sync-app-prompt.sh"],
    visibility = ["//apps/clax_app:__pkg__"],
)

# The brand's token generator and the app icons' renderer, which
# //design:tokens_sync and //design:icons_sync run with --check.
exports_files(
    [
        "build-app-icons.sh",
        "sync-tokens.py",
    ],
    visibility = ["//design:__pkg__"],
)

# clax-embedded's compile inputs include generated directories (the web
# builds), so rules_rust places its sources in bazel-bin, and its
# include_str!s of files outside the crate resolve there: these are those
# files, copied beside it.
copy_to_bin(
    name = "ensure_clax_bin",
    srcs = ["ensure-clax.sh"],
    visibility = ["//crates:__subpackages__"],
)

# The scripts the Rust tests run or read.
filegroup(
    name = "test_scripts",
    srcs = [
        "ensure-clax.sh",
        "fake-exe.sh",
        "stable-bin.sh",
    ],
    visibility = ["//crates:__subpackages__"],
)

# The plugin hook scripts clax-server's tests compare with each plugin's copy
# (crates/clax-server/src/routes/guards.rs).
filegroup(
    name = "hook_scripts",
    srcs = [
        "ensure-clax.sh",
        "tool-hook.sh",
    ],
    visibility = ["//crates:__subpackages__"],
)

# Every script, for the tests that scan or run them
# (crates/clax-cli/tests/extension.rs, verify_harnesses.rs; the gates below).
filegroup(
    name = "all",
    srcs = glob(
        ["**"],
        exclude = [
            "**/.qual",
            "BUILD.bazel",
        ],
    ),
    visibility = ["//visibility:public"],
)

CLAX = [
    "//crates/clax-cli:clax",
    "//crates/clax-cli:clax_warm",
]

CLAX_ENV = {"CLAX_TEST_BIN": "$(rootpath //crates/clax-cli:clax)"}

RUST_SOURCES = [
    "//crates/clax-cli:rust_sources",
    "//crates/clax-commands:rust_sources",
    "//crates/clax-content-git:rust_sources",
    "//crates/clax-core:rust_sources",
    "//crates/clax-embedded:rust_sources",
    "//crates/clax-fake-exe:rust_sources",
    "//crates/clax-git:rust_sources",
    "//crates/clax-hooks:rust_sources",
    "//crates/clax-http:rust_sources",
    "//crates/clax-ios:rust_sources",
    "//crates/clax-mcp:rust_sources",
    "//crates/clax-realtime:rust_sources",
    "//crates/clax-rt:rust_sources",
    "//crates/clax-sample:rust_sources",
    "//crates/clax-server:rust_sources",
    "//crates/clax-store:rust_sources",
    "//crates/clax-testkit:rust_sources",
]

# Every crate's manifest, which the layering check reads.
CRATE_MANIFESTS = [
    "//crates/clax-cli:manifest",
    "//crates/clax-commands:manifest",
    "//crates/clax-content-git:manifest",
    "//crates/clax-core:manifest",
    "//crates/clax-embedded:manifest",
    "//crates/clax-fake-exe:manifest",
    "//crates/clax-git:manifest",
    "//crates/clax-hooks:manifest",
    "//crates/clax-http:manifest",
    "//crates/clax-ios:manifest",
    "//crates/clax-mcp:manifest",
    "//crates/clax-realtime:manifest",
    "//crates/clax-rt:manifest",
    "//crates/clax-sample:manifest",
    "//crates/clax-server:manifest",
    "//crates/clax-store:manifest",
    "//crates/clax-testkit:manifest",
]

# The script gates of scripts/quality_gates.sh, as Bazel tests. Each script
# starts with `cd "$(dirname "$0")/.."`, which is the runfiles root here.
# docs/bazel.md, "Run outside Bazel", lists the gates that stay native.

sh_test(
    name = "release",
    srcs = ["test-release.sh"],
    data = [":all"] + RELEASE_FILES,
)

sh_test(
    name = "installer",
    srcs = ["test-install.sh"],
    data = [
        ":all",
        "//:install.sh",
    ],
)

sh_test(
    name = "tool_hook",
    srcs = ["test-tool-hook.sh"],
    data = [":all"],
)

# scripts/build-app-clax.sh's dry runs (the native build of the Clax app's
# embedded clax).
sh_test(
    name = "build_app_clax",
    srcs = ["test-build-app-clax.sh"],
    data = [":all"],
)

sh_test(
    name = "stable_bin",
    srcs = ["test-stable-bin.sh"],
    data = [":all"],
)

sh_test(
    name = "fake_exe",
    srcs = ["test-fake-exe.sh"],
    data = [":all"],
)

sh_test(
    name = "plugin_wrapper",
    srcs = ["test-ensure-clax.sh"],
    data = CLAX + [
        ":all",
        "//:Cargo.toml",
        "//crates/clax-mcp:rust_sources",
        "//plugins:embedded",
        "//plugins/pi:embedded",
    ],
    env = CLAX_ENV,
)

sh_test(
    name = "comment_loop",
    srcs = ["smoke-comment-loop.sh"],
    data = CLAX + [
        ":all",
        "//crates/clax-hooks:fixtures",
    ],
    env = CLAX_ENV,
)

# The layout's order of the crates (scripts/check-crate-layers.py), and the
# check's own test.
sh_test(
    name = "crate_layers",
    srcs = ["test-check-crate-layers.sh"],
    data = CRATE_MANIFESTS + [
        ":all",
        "//:Cargo.toml",
        "@rules_rust//rust/toolchain:current_cargo_files",
    ],
    # The check reads the workspace through `cargo metadata`.
    env = {"CARGO": "$(rootpath @rules_rust//rust/toolchain:current_cargo_files)"},
)

# scripts/sync-tokens.py on a copy of its inputs: in step, stale, low
# contrast, drifted app-mode colours.
sh_test(
    name = "sync_tokens",
    srcs = ["test-sync-tokens.sh"],
    data = [
        ":all",
        "//apps/clax_app:token_outputs",
        "//design:tokens",
        "//web:token_inputs",
    ],
)

# scripts/build-app-icons.sh on a copy of its sources and outputs: in step,
# a stale mark or colour, a hand-edited output, a missing renderer, and
# every PNG rendered at its size.
sh_test(
    name = "build_app_icons",
    srcs = ["test-build-app-icons.sh"],
    data = [
        ":all",
        "//apps/clax_app:icon_outputs",
        "//design:tokens",
    ],
)

# No `unsafe` but clax-ios's four exported C functions, and every other
# crate on the workspace's lints (AGENTS.md); and the check's own test.
sh_test(
    name = "no_unsafe",
    srcs = ["check-no-unsafe.sh"],
    data = RUST_SOURCES + CRATE_MANIFESTS + ["//:Cargo.toml"],
)

sh_test(
    name = "no_unsafe_test",
    srcs = ["test-check-no-unsafe.sh"],
    data = [":all"],
)

# The checks' own tests; the scans of every tracked file read git and run
# outside Bazel (scripts/bazel-test.sh).
sh_test(
    name = "no_hard_links",
    srcs = ["test-check-no-hard-links.sh"],
    data = [":all"],
)

sh_test(
    name = "pipefail_pipes",
    srcs = ["test-check-pipefail-pipes.sh"],
    data = [":all"],
)

# No process launch in the crates the iOS daemon links unless
# scripts/ios-spawns.allow names it (iOS lets an app start no other
# program), and the check's own test.
sh_test(
    name = "ios_spawns",
    srcs = ["check-ios-spawns.sh"],
    data = RUST_SOURCES + ["ios-spawns.allow"],
)

sh_test(
    name = "ios_spawns_test",
    srcs = ["test-check-ios-spawns.sh"],
    data = [":all"],
)

# The perf benchmarks, on demand only (`just perf`): on the optimized clax,
# alone and one at a time (exclusive), outside the sandbox. They print each
# measure beside its budget and fail no check; no check runs them (`manual`).
PERF_DATA = [
    ":all",
    "//crates/clax-cli:clax_opt",
    "//crates/clax-cli:clax_opt_warm",
]

PERF_ENV = {"CLAX_PERF_BIN": "$(rootpath //crates/clax-cli:clax_opt)"}

[sh_test(
    name = name + "_full",
    srcs = [script],
    data = PERF_DATA,
    env = PERF_ENV,
    tags = [
        "exclusive",
        "manual",
        "no-sandbox",
    ],
) for name, script in [
    ("perf_daemon", "perf-daemon.sh"),
    ("perf_clients", "perf-clients.sh"),
]]

# scripts/run.sh's choice of build system, on a PATH of stub tools.
sh_test(
    name = "run_choice",
    srcs = ["run.test.sh"],
    data = [
        ":all",
        "//:.bazelversion",
        "//web:package.json",
    ],
)

# scripts/bazel-gc.sh on throwaway directories.
sh_test(
    name = "bazel_gc",
    srcs = ["bazel-gc.test.sh"],
    data = [":all"],
)
